# Animated build-up of the Gimlé module lifecycle. Render (from repo root):
#   .claude/skills/bragi/scripts/render-diagrams.sh gimle-docs/diagrams/module-lifecycle.d2
# Steps compose cumulatively; each step accents the newly-reached state and dims the rest.
direction: down

classes: {
  current: {style: {fill: "#2a5a8c"; font-color: "#ffffff"; stroke: "#1e3f61"}}
  past: {style: {opacity: 0.4}}
}

steps: {
  1: {
    installed: INSTALLED {class: current}
  }
  2: {
    installed.class: past
    installed -> resolved: dependencies satisfied
    resolved: RESOLVED {class: current}
  }
  3: {
    resolved.class: past
    resolved -> starting: build ModuleLayer, run hooks
    starting: STARTING {class: current}
  }
  4: {
    starting.class: past
    starting -> active: readiness probe passes
    active: ACTIVE {class: current}
  }
  5: {
    active.class: past
    active -> stopping: drain
    stopping: STOPPING {class: current}
  }
  6: {
    stopping.class: past
    stopping -> uninstalled: dispose ModuleLayer
    uninstalled: UNINSTALLED {class: current}
  }
}
