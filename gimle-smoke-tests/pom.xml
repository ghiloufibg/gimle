<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.gimle</groupId>
    <artifactId>gimle</artifactId>
    <version>0.1.0-alpha.1</version>
  </parent>

  <artifactId>gimle-smoke-tests</artifactId>
  <packaging>jar</packaging>

  <name>Gimle Smoke Tests</name>
  <description>
    A real end-to-end smoke suite: spawns a genuine ControlPlaneMain + AgentMain (+ its own
    WorkerMain child) subprocess cluster -- unlike every other integration test in this repo,
    which constructs ApiServer directly in-JVM, this needs the real bundled web console
    (BundledConsole/ApiServer.serveConsole) that only a real ControlPlaneMain process serves, since
    the Playwright suite this drives (gimle-console's own e2e/) needs a real browser hitting a real
    server. Deploys the greeter-provider/greeter-consumer sample modules (gimle-examples/), asserts
    real API-level behavior (both reach ACTIVE, the consumer's real fabric call to the provider
    shows up in its own logs), then runs the Playwright suite against that same live cluster.
    Test-only: no main sources. Deliberately not part of the default `mvn verify` -- opt in with
    `-Psmoke`, matching the existing runtime-image profile's precedent, since this is slow
    (spins up real JVMs and a real browser) and needs `mvn install` to have already produced every
    jar it launches.
  </description>

  <properties>
    <!-- Test-only, not part of Gimle's platform API surface: excluded from the aggregate
         Javadoc the docs site publishes (see the root pom's maven-javadoc-plugin pluginManagement
         entry). -->
    <maven.javadoc.skip>true</maven.javadoc.skip>
    <!-- Overrides the root .mvn/maven-build-cache-config.xml's global enabled=true: this
         module's cacheable behavior depends on whether -Psmoke is active (a plain verify runs
         no *IT.java at all; -Psmoke runs the full real-cluster suite), which the build cache's
         source-fingerprint hash has no visibility into. A cache hit recorded under one profile
         state and replayed under the other would silently skip tests that needed to run. -->
    <maven.build.cache.enabled>false</maven.build.cache.enabled>
  </properties>

  <dependencies>
    <!-- Heimdall (the event-driven cluster-condition watcher), Await, and PortLease: the same
         real-cluster test infrastructure gimle-holmgang's own suite is built on. -->
    <dependency>
      <groupId>com.gimle</groupId>
      <artifactId>gimle-testkit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.gimle</groupId>
      <artifactId>gimle-controlplane</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.gimle</groupId>
      <artifactId>gimle-agent</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.gimle</groupId>
      <artifactId>gimle-worker</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      TestModuleBuilder (compiles a real, tiny JPMS module in-process via javax.tools.JavaCompiler):
      used to build a genuine "v2" of greeter-provider at test run time for the rolling-update
      scenario, without committing a second, near-duplicate example module just to change one
      version number and one string. The same technique gimle-worker's own
      RealBundledHookAndProbeInvocationTest already uses to compile real bundled hooks/probes.
    -->
    <dependency>
      <groupId>com.gimle</groupId>
      <artifactId>gimle-module</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <!--
      gimle-controlplane's own gimle-fafnir dependency is test-scoped and therefore not
      transitive, so this module needs its own dependency to get FafnirMain onto the fork
      classpath the real Fafnir replica subprocesses below are launched against.
    -->
    <dependency>
      <groupId>com.gimle</groupId>
      <artifactId>gimle-fafnir</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Same reasoning as gimle-fafnir above, for MuninnMain. -->
    <dependency>
      <groupId>com.gimle</groupId>
      <artifactId>gimle-muninn</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Same reasoning again, for AndvariMain: the artifact registry replica the smoke cluster
         spawns and AndvariRegistryIT resolves a coordinate-only deployment through. -->
    <dependency>
      <groupId>com.gimle</groupId>
      <artifactId>gimle-andvari</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Same reasoning again, for SkaldMain: the cluster DNS replica ServiceNetworkIT spawns to
         resolve a Service's own name over a real UDP query. Explicit version rather than relying
         on the root pom's own dependencyManagement: gimle-skald is registered in the root
         reactor's <modules> but was never added to that block, so a version here is required. -->
    <dependency>
      <groupId>com.gimle</groupId>
      <artifactId>gimle-skald</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <!--
      Real synthetic HTTP load for the multi-signal-autoscaling-under-real-load QA scenario
      (AutoscaleIT#a_deployment_scales_up_under_real_gatling_generated_request_rate_load): Gatling
      drives
      real, controllable-rate HTTP traffic at greeter-load-generator (gimle-examples/), which turns
      every request into one real fabric call to greeter-provider: the actual signal
      AutoscaleReconciler's requestRatePerSecond target reads, not a synthetic stand-in for it.
      gatling-charts-highcharts is the standard self-contained CLI runner aggregate (pulls in
      gatling-app/gatling-core/gatling-http and the HTML report generator); gatling-http-java is the
      Java DSL used to write the simulation itself.
    -->
    <dependency>
      <groupId>io.gatling.highcharts</groupId>
      <artifactId>gatling-charts-highcharts</artifactId>
      <version>3.13.5</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.gatling</groupId>
      <artifactId>gatling-http-java</artifactId>
      <version>3.13.5</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        Two independent, redundant defenses against this suite ever running under plain
        mvn verify (it spins up real JVM subprocess clusters and a real browser): the excludes
        pattern below is Surefire's own default *IT.java convention made explicit, but that alone
        isn't enough, since an unqualified -Dtest='!A,!B,...' (exclusions only, no positive
        pattern), the shape a root-level verify command takes when it maintains a standing
        flaky-test exclusion list, has been observed to override excludes and broaden
        Surefire's own class discovery enough to pick GreeterSmokeTestIT up anyway, even with the
        smoke profile (and its own failsafe binding below) never activated: a real build-wiring
        gap, not a flaky test. excludedGroups is the actual fix: JUnit 5's own tag-based filtering
        is a separate mechanism from Surefire's class-name pattern selection, applied after
        -Dtest's own class-file selection has already run, so it isn't affected by that override
        the same way. Every concrete *IT class in this package (GreeterClusterTopologyIT,
        RaftResilienceIT, ObservabilityIT, SelfHealingIT, QuotaIT, AutoscaleIT, RollingUpdateIT,
        all sharing the GreeterSmokeClusterSupport fixture) carries @Tag("smoke") for exactly
        this.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>**/*IT.java</exclude>
          </excludes>
          <excludedGroups>smoke</excludedGroups>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>smoke</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <executions>
              <execution>
                <goals>
                  <goal>integration-test</goal>
                  <goal>verify</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
