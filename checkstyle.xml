<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Gimlé project-wide Checkstyle rules. Deliberately minimal: formatting is
  google-java-format's job (fmt-maven-plugin), this file only enforces
  conventions gjf doesn't cover — currently just the snake_case method
  naming deviation from standard Java camelCase (see CLAUDE.md).
-->
<module name="Checker">
  <!-- The rare, unavoidable exception: a method overriding a fixed JDK contract
       (Comparable#compareTo, Object#toString, ...) cannot be snake_case. Suppressions
       are centralized in checkstyle-suppressions.xml (by method, via XPath — not by
       line number, which would silently drift as the file changes) rather than
       @SuppressWarnings in source, per project preference. -->
  <module name="TreeWalker">
    <module name="SuppressionXpathFilter">
      <property name="file" value="checkstyle-suppressions.xml"/>
    </module>
    <module name="MethodName">
      <property name="format" value="^[a-z][a-z0-9]*(_[a-z0-9]+)*$"/>
      <message key="name.invalidPattern"
               value="Method name ''{0}'' must be snake_case, matching pattern ''{1}'' (project convention, see CLAUDE.md)."/>
    </module>
  </module>
</module>
