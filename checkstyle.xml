<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Gimlé project-wide Checkstyle rules. Deliberately minimal: formatting is
  google-java-format's job (fmt-maven-plugin); this file only enforces
  conventions gjf doesn't cover.

  Method naming (see CLAUDE.md): standard camelCase everywhere, except methods directly
  annotated @Test, @ParameterizedTest, or @RepeatedTest, which are snake_case so a test's name
  reads as a sentence describing the behavior it verifies. Two MethodName instances implement the
  split; which one applies to a given method is decided by the XPath suppressions in
  checkstyle-suppressions.xml, keyed on the presence/absence of @Test/@ParameterizedTest/
  @RepeatedTest.

  A Thread.sleep ban across the real-cluster test harness and its own consumers (gimle-testkit,
  gimle-holmgang, gimle-smoke-tests): a fixed sleep is a race against however long the real
  condition actually takes, where Heimdall/Await's own event-driven waits complete the instant
  the condition is satisfied and fail fast with a forensic report otherwise. Scoped by file path
  in checkstyle-suppressions.xml (only those three modules are subject to it at all) rather than
  repo-wide, since every other module's own test suite has its own established polling idioms
  this change doesn't touch. A short, explicit allow-list grandfathers gimle-testkit's own
  Await/Heimdall implementation (the one place a real sleep belongs) and every already-existing,
  already-documented deliberate sleep (rate-limiter pacing, workload dwell timing) predating this
  rule; the ban is on adding a new one, not rewriting every old one in the same change.
-->
<module name="Checker">
  <module name="TreeWalker">
    <module name="SuppressionXpathFilter">
      <property name="file" value="${config_loc}/checkstyle-suppressions.xml"/>
    </module>

    <!-- Applies to @Test/@ParameterizedTest/@RepeatedTest methods only (suppressed everywhere
         else, see checkstyle-suppressions.xml). @BeforeEach/etc. lifecycle hooks are deliberately
         not included here: only a method whose annotation directly drives a reported test case
         keeps a method snake_case. -->
    <module name="MethodName">
      <property name="id" value="TestMethodName"/>
      <property name="format" value="^[a-z][a-z0-9]*(_[a-z0-9]+)*$"/>
      <message key="name.invalidPattern"
               value="Test method name ''{0}'' must be snake_case, matching pattern ''{1}'' (project convention: @Test/@ParameterizedTest/@RepeatedTest methods only, see CLAUDE.md)."/>
    </module>

    <!-- Applies to every method that is not @Test/@ParameterizedTest/@RepeatedTest (suppressed
         for those, see checkstyle-suppressions.xml): production code, JUnit lifecycle hooks,
         @MethodSource factories, and private/helper methods in test classes. -->
    <module name="MethodName">
      <property name="id" value="ProductionMethodName"/>
      <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
      <message key="name.invalidPattern"
               value="Method name ''{0}'' must be camelCase, matching pattern ''{1}'' (project convention: only @Test/@ParameterizedTest/@RepeatedTest methods are snake_case, see CLAUDE.md)."/>
    </module>

    <!-- Suppressed everywhere except gimle-testkit/gimle-holmgang/gimle-smoke-tests (file-path
         scoped in checkstyle-suppressions.xml), and within those, grandfathered for
         gimle-testkit's own Await/Heimdall implementation and every already-existing sleep
         predating this rule. -->
    <module name="RegexpSinglelineJava">
      <property name="id" value="TestThreadSleepBan"/>
      <property name="format" value="Thread\.sleep\("/>
      <property name="ignoreComments" value="true"/>
      <property name="message"
                value="Thread.sleep is banned here -- wait on a real condition through gimle-testkit's Await/Heimdall instead of a fixed sleep (project convention, see CLAUDE.md)."/>
    </module>
  </module>
</module>
