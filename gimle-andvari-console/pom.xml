<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.gimle</groupId>
    <artifactId>gimle</artifactId>
    <version>0.1.0-alpha.2</version>
  </parent>

  <artifactId>gimle-andvari-console</artifactId>
  <packaging>jar</packaging>

  <name>Gimle Andvari Console</name>
  <description>
    Andvari's own web console SPA, built and tested by Bun but wrapped as a plain Maven module so
    `mvn verify` covers it too -- no Java sources here, just exec-maven-plugin executions that
    shell out to Bun and a resources-copy step that lands the built SPA at andvari-console/**
    inside this module's own jar, for gimle-andvari to depend on and serve at its own /console
    (see AndvariServer.serveConsole / AndvariMain). Mirrors gimle-fafnir-console's exact pom.xml
    shape; the only difference is the bundled prefix (andvari-console/** instead of
    fafnir-console/**), so the two never collide on a classpath that somehow carried both.
  </description>

  <properties>
    <!-- Same reasoning as gimle-console's/gimle-fafnir-console's own maven.build.cache.enabled
         override: this module's real inputs (*.ts/*.tsx/package.json/bun.lock) are invisible to
         the root build-cache config's *.java/*.xml/*.yaml/*.properties glob. -->
    <maven.build.cache.enabled>false</maven.build.cache.enabled>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>bun-install</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>bun</executable>
              <workingDirectory>${project.basedir}</workingDirectory>
              <arguments>
                <argument>install</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>bun-build</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>bun</executable>
              <workingDirectory>${project.basedir}</workingDirectory>
              <arguments>
                <argument>run</argument>
                <argument>build</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>bun-test</id>
            <phase>test</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <!-- exec-maven-plugin has no built-in notion of "this is a test execution" the way
                   surefire does, so neither -DskipTests nor -Dmaven.test.skip does anything to it
                   without this explicit binding to the root pom's own property, which tracks
                   both. -->
              <skip>${gimle.console.skipTests}</skip>
              <executable>bun</executable>
              <workingDirectory>${project.basedir}</workingDirectory>
              <arguments>
                <argument>run</argument>
                <argument>test</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-clean-plugin</artifactId>
        <executions>
          <!-- Empties the bundled-SPA directory before the copy below refills it. Vite empties its
               own dist/ on every build, but target/classes survives an incremental build, so
               without this every hashed chunk from every previous build stays in the jar forever:
               the artifact grows without bound and "which bundle is shipping" stops having one
               answer. Scoped to this one directory: excludeDefaultDirectory keeps a plain
               `mvn package` from wiping the whole target/ out from under itself. -->
          <execution>
            <id>clean-bundled-spa</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>clean</goal>
            </goals>
            <configuration>
              <excludeDefaultDirectory>true</excludeDefaultDirectory>
              <filesets>
                <fileset>
                  <directory>${project.build.outputDirectory}/andvari-console</directory>
                </fileset>
              </filesets>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <!-- Copies Vite's own conventional dist/ output (produced by the bun-build execution
               above) into this module's own jar under andvari-console/**, for gimle-andvari to
               read off its classpath at runtime (see AndvariMain's BundledSpa.resolve call). -->
          <execution>
            <id>copy-andvari-console-dist</id>
            <phase>process-resources</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}/andvari-console</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.basedir}/dist</directory>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
