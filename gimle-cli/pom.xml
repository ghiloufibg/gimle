<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.gimle</groupId>
    <artifactId>gimle</artifactId>
    <version>0.1.0-alpha.2</version>
  </parent>

  <artifactId>gimle-cli</artifactId>
  <packaging>jar</packaging>

  <name>Gimle CLI</name>
  <description>
    A kubectl-shaped command-line client for the control plane's HTTP API -- for muscle
    memory, without any Kubernetes API compatibility claim.
  </description>

  <properties>
    <!-- Runtime-image profile (root pom): see gimle-agent/pom.xml for how this list was derived.
         java.logging is here for JLine, which the CLI archive ships alongside gimle-hugin for the
         `top` verb: org.jline.utils.Log is a java.util.logging front end, and its static
         initializer runs while a terminal is being built, so a JRE without java.logging fails that
         verb with NoClassDefFoundError rather than degrading. -->
    <gimle.runtimeImage.launcherClass>com.gimle.cli.GimleCli</gimle.runtimeImage.launcherClass>
    <gimle.runtimeImage.jdkModules>java.base,java.net.http,java.logging</gimle.runtimeImage.jdkModules>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.gimle</groupId>
      <artifactId>gimle-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.gimle</groupId>
      <artifactId>gimle-core</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
    </dependency>
    <!-- CertCommand generates its own CSRs locally (its own operator-facing
         verbs); never signs anything itself, that's gimle-controlplane's job. -->
    <dependency>
      <groupId>com.gimle</groupId>
      <artifactId>gimle-pki</artifactId>
    </dependency>
    <!-- ArtifactCommand derives a push's registry coordinate from the jar's own bundled
         gimle-module.yaml via ModuleArtifactReader, never from flags. -->
    <dependency>
      <groupId>com.gimle</groupId>
      <artifactId>gimle-module</artifactId>
    </dependency>
    <dependency>
      <groupId>com.gimle</groupId>
      <artifactId>gimle-controlplane</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Compile scope (not test-only): SealCommand's "seal value" verb runs SealCipher.seal
         directly, entirely offline, rather than calling the control plane, since the whole point
         of the sealing workflow is that no network round-trip (and no live authenticated session)
         is needed to produce a sealed blob. GimleCliTest also reuses this dependency for a real,
         in-process FafnirServer/FafnirClient pair backing it, the same "small enough to duplicate
         rather than a new coupling" InProcessFafnir fixture shape gimle-controlplane's own tests
         already use. -->
    <dependency>
      <groupId>com.gimle</groupId>
      <artifactId>gimle-fafnir</artifactId>
    </dependency>
    <!-- HistoryCommandTest reads metrics/traces history back through the control plane's own
         proxy, which only has anything to proxy to when a real Muninn is running behind it. -->
    <dependency>
      <groupId>com.gimle</groupId>
      <artifactId>gimle-muninn</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- ArtifactSetCommandTest needs a real, in-process AndvariServer behind ApiServer's own
         /artifacts/* proxy to exercise a genuine multi-jar apply against the real registry, not a
         mock. -->
    <dependency>
      <groupId>com.gimle</groupId>
      <artifactId>gimle-andvari</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- TestModuleBuilder compiles real, tiny module jars in-process, since ArtifactSetCommand
         (like the single-jar `artifact push` it's built on) rejects anything that isn't a real
         JPMS module with a gimle-module.yaml. -->
    <dependency>
      <groupId>com.gimle</groupId>
      <artifactId>gimle-module</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <!-- Keeps every test in this module off the developer's own ~/.gimle/config: a real
                 one on the machine running the build would otherwise silently supply a server to
                 tests asserting that none is configured. Nothing creates this path. -->
            <gimle.cli.configFile>${project.build.directory}/no-such-gimle-config</gimle.cli.configFile>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <!--
        No cyclonedx-maven-plugin execution here: the standalone CLI archive (gimle-dist's own
        cli.xml assembly descriptor) ships gimle-hugin's own jline-terminal/jline-terminal-ffm
        dependencies alongside this module's, and cyclonedx-maven-plugin's makeBom has no
        artifact-level include/exclude filter, always describing the current project's own full
        dependency graph, never an arbitrary subset. gimle-cli's own graph can never be made to
        include those two jars either: gimle-hugin implements the CliExtension this module defines,
        so gimle-hugin already depends on gimle-cli, and the reverse dependency would be circular.
        gimle-hugin's graph is the one that genuinely equals what the archive ships (this module's
        whole closure plus the two jline jars), so gimle-dist copies gimle-hugin's own
        target/bom.json, rewriting its root component from gimle-hugin to gimle-cli, into
        gimle-cli-*-cyclonedx.json instead; see gimle-hugin/pom.xml's own cyclonedx-maven-plugin
        comment.
      -->
    </plugins>
  </build>
</project>
