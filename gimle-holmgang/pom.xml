<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.gimle</groupId>
    <artifactId>gimle</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>gimle-holmgang</artifactId>
  <packaging>jar</packaging>

  <name>Gimle Holmgang</name>
  <description>
    Functional cluster validation: boots a real multi-process Gimle cluster from a declarative
    topology (a YAML file or an equivalent Java builder -- replica counts per process kind, node
    count and labels, transport) and validates end-to-end behavior against it. Test-only: no main
    sources. Unlike gimle-smoke-tests' single hard-coded topology, every port here is leased
    dynamically at boot and every count comes from the topology document, so different cluster
    shapes can be exercised without editing a fixture. Deliberately not part of the default
    `mvn verify` -- opt in with `-Pvalidation`, matching gimle-smoke-tests' own `-Psmoke`
    precedent, since this spawns real JVM subprocess clusters and needs `mvn install` to have
    already produced the example-module jars it deploys.
  </description>

  <properties>
    <cucumber.version>7.20.1</cucumber.version>
    <!-- Test-only, not part of Gimle's platform API surface: excluded from the aggregate
         Javadoc the docs site publishes (see the root pom's maven-javadoc-plugin pluginManagement
         entry). -->
    <maven.javadoc.skip>true</maven.javadoc.skip>
    <!-- Overrides the root .mvn/maven-build-cache-config.xml's global enabled=true: this
         module's cacheable behavior depends on whether -Pvalidation is active (a plain verify
         runs no *IT.java at all; -Pvalidation runs the full real-cluster suite), which the build
         cache's source-fingerprint hash has no visibility into. A cache hit recorded under one
         profile state and replayed under the other would silently skip tests that needed to
         run. -->
    <maven.build.cache.enabled>false</maven.build.cache.enabled>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.gimle</groupId>
      <artifactId>gimle-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.gimle</groupId>
      <artifactId>gimle-controlplane</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.gimle</groupId>
      <artifactId>gimle-agent</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.gimle</groupId>
      <artifactId>gimle-worker</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      gimle-controlplane's own gimle-fafnir dependency is test-scoped and therefore not
      transitive, so this module needs its own dependency to get FafnirMain onto the fork
      classpath the real Fafnir replica subprocesses are launched against, the same reasoning as
      gimle-smoke-tests' own dependency on it.
    -->
    <dependency>
      <groupId>com.gimle</groupId>
      <artifactId>gimle-fafnir</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Same reasoning as gimle-fafnir above, for MuninnMain. -->
    <dependency>
      <groupId>com.gimle</groupId>
      <artifactId>gimle-muninn</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Same reasoning as gimle-fafnir above, for AndvariMain. -->
    <dependency>
      <groupId>com.gimle</groupId>
      <artifactId>gimle-andvari</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- PkiBootstrapMain (mTLS topologies generate their material through it) and GimleCli
         (bootstrap tokens are minted through the real CLI with the operator identity) are both
         spawned against this test JVM's own classpath, so each must be a direct dependency. -->
    <dependency>
      <groupId>com.gimle</groupId>
      <artifactId>gimle-pki</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- StoreClient/StoreRpc.Status: leader-targeted and membership-change scenarios talk to the
         store's own status and membership surface directly. -->
    <dependency>
      <groupId>com.gimle</groupId>
      <artifactId>gimle-mimir</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.gimle</groupId>
      <artifactId>gimle-cli</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- LaunchPlanner/Topology: this class now builds a gimle-hilmir Topology from ClusterSpec and
         hands it to LaunchPlanner rather than hand-building process commands itself. -->
    <dependency>
      <groupId>com.gimle</groupId>
      <artifactId>gimle-hilmir</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      TestModuleBuilder (compiles a real, tiny JPMS module in-process via javax.tools): builds
      genuine chaos/upgrade variants of greeter-provider at scenario run time (a real v1.1.0 for
      rolling updates, an always-failing-liveness build for self-healing escalation) without
      committing near-duplicate example modules, the same technique gimle-smoke-tests uses.
    -->
    <dependency>
      <groupId>com.gimle</groupId>
      <artifactId>gimle-module</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <!--
      The Gherkin layer: scenarios live in src/test/resources/features and run on the JUnit
      Platform through the single failsafe-matched HolmgangIT suite. cucumber-picocontainer is
      the DI glue sharing one ScenarioWorld across step classes; junit-platform-suite provides
      the @Suite runner (version managed by the root pom's junit-bom import).
    -->
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-java</artifactId>
      <version>${cucumber.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-junit-platform-engine</artifactId>
      <version>${cucumber.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-picocontainer</artifactId>
      <version>${cucumber.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-suite</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      Real, controllable-rate HTTP load for autoscale scenarios, spawned as Gatling's own CLI in
      a separate JVM (its runtime is not designed to run twice in one JVM), with the same versions
      and reasoning as gimle-smoke-tests' own Gatling dependency. gatling-charts-highcharts is
      the self-contained CLI runner aggregate; gatling-http-java is the DSL the simulation is
      written in.
    -->
    <dependency>
      <groupId>io.gatling.highcharts</groupId>
      <artifactId>gatling-charts-highcharts</artifactId>
      <version>3.13.5</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.gatling</groupId>
      <artifactId>gatling-http-java</artifactId>
      <version>3.13.5</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        Two independent, redundant defenses against the real-cluster suite ever running under
        plain mvn verify, copied verbatim from gimle-smoke-tests, where an unqualified
        -Dtest='!A,!B,...' (exclusions only, no positive pattern) was observed to broaden
        Surefire's own default class discovery enough to pick an *IT class up anyway: the
        excludes pattern alone is not enough, and JUnit 5's tag-based excludedGroups filtering is
        a separate mechanism unaffected by that override. Every concrete *IT class in this module
        carries @Tag("holmgang") for exactly this. Plain unit tests (topology parsing, port
        leasing) still run under the default build, keeping this module compiling and covered
        even when no real cluster is ever spawned.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>**/*IT.java</exclude>
          </excludes>
          <excludedGroups>holmgang</excludedGroups>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>validation</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <executions>
              <execution>
                <goals>
                  <goal>integration-test</goal>
                  <goal>verify</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
