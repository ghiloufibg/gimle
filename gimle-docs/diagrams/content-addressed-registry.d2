# Three scenarios sharing one base: what happens when the same coordinate is pushed to Andvari
# again, depending on whether the bytes match. Render:
#   .claude/skills/bragi/scripts/render-diagrams.sh gimle-docs/diagrams/content-addressed-registry.d2
direction: right

classes: {
  calm: {style: {fill: "#ffffff"; stroke: "#2a5a8c"}}
  accent: {style: {fill: "#2a5a8c"; font-color: "#ffffff"; stroke: "#1e3f61"}}
  ok: {style: {fill: "#7cbf8e"; font-color: "#1b1b1d"; stroke: "#4f8a60"}}
  reject: {style: {fill: "#d97b7b"; font-color: "#ffffff"; stroke: "#a34e4e"}}
}

store: "Andvari\n(greeter-provider@1.0.0\nsha256: a1b2...)" {shape: cylinder; class: calm}
push: "PUT /artifacts/greeter-provider/1.0.0" {class: accent}
push -> store: "streamed, digested\nwhile writing" {style.animated: true}

scenarios: {
  identical-bytes: {
    store -> verdict: "digest matches\nstored sha256" {style.animated: true}
    verdict: "200, idempotent no-op --\nnothing rewritten" {class: ok}
  }
  different-bytes-same-coordinate: {
    store -> verdict: "digest differs from\nstored sha256" {style.animated: true}
    verdict: "409 Conflict --\npush a new version instead" {class: reject}
  }
  new-version: {
    push: "PUT /artifacts/greeter-provider/1.1.0" {class: accent}
    store -> verdict: "coordinate not\nseen before" {style.animated: true}
    verdict: "200, new immutable entry\nvia temp-file + atomic rename" {class: ok}
  }
}
