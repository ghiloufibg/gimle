# Build-up of a secret's life through Fafnir: write, read, rotate, and the node's direct fetch
# path. Render: .claude/skills/bragi/scripts/render-diagrams.sh gimle-docs/diagrams/secrets-lifecycle.d2
direction: down

classes: {
  new: {style: {fill: "#2a5a8c"; font-color: "#ffffff"; stroke: "#1e3f61"}}
  settled: {style: {opacity: 0.85}}
}

steps: {
  1: {
    operator: Operator {class: new}
    cp: "Control Plane" {class: new}
    fafnir: Fafnir {class: new}
    operator -> cp: "gimle secret set" {style.animated: true}
    cp -> fafnir: "POST /secrets/*, mTLS,\nforwards caller identity --\nFafnir re-checks RBAC itself" {style.animated: true}
  }
  2: {
    operator.class: settled
    cp.class: settled
    fafnir.class: settled
    ring: "KeyRing\n(active AES-256 key)" {shape: cylinder; class: new}
    store: "key\@N versions\nover /config/* store" {shape: cylinder; class: new}
    fafnir -> ring: SecretCipher.encrypt {style.animated: true}
    ring -> store: "write version‖keyId‖iv‖ciphertext" {style.animated: true}
  }
  3: {
    ring.class: settled
    store.class: settled
    operator.class: new
    operator -> cp: "gimle secret get [--version N]" {style.animated: true}
    cp -> fafnir: proxies read {style.animated: true}
    fafnir -> store: "fetch key\@N or key\@meta" {style.animated: true}
    store -> ring: decrypt by embedded keyId {style.animated: true}
  }
  4: {
    operator.class: settled
    cp.class: settled
    fafnir.class: settled
    store.class: settled
    ring.class: new
    operator2: Operator {class: new}
    operator2 -> cp: "gimle secret rotate-key" {style.animated: true}
    cp -> fafnir: "POST /secrets/rotate-key" {style.animated: true}
    fafnir -> ring: mint new active key {style.animated: true}
    ring -> store: "re-encrypt every reachable entry --\nold keys kept, never deleted" {style.animated: true}
  }
  5: {
    operator2.class: settled
    ring.class: settled
    node: "Node Agent" {class: new}
    node -> fafnir: "fetches secret values directly,\nown mTLS identity, no Control Plane hop --\nonly for tenants it has an\nactive assignment for" {style.animated: true}
  }
}
