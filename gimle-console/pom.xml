<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.gimle</groupId>
    <artifactId>gimle</artifactId>
    <version>0.1.0-alpha.2</version>
  </parent>

  <artifactId>gimle-console</artifactId>
  <packaging>jar</packaging>

  <name>Gimle Console</name>
  <description>
    The web console SPA (Vite/React/TanStack Router/Zustand/Tailwind), built and tested by Bun
    but wrapped as a plain Maven module so `mvn verify` covers it too: no Java sources here, just
    exec-maven-plugin executions that shell out to Bun (the same pattern the root pom's
    runtime-image profile already uses for jlink) and a resources-copy step that lands the built
    SPA at console/** inside this module's own jar, for gimle-controlplane to depend on and serve.
  </description>

  <properties>
    <!-- Overrides the root .mvn/maven-build-cache-config.xml's global enabled=true: this
         module's real inputs are *.ts/*.tsx/package.json/bun.lock, invisible to that config's
         *.java/*.xml/*.yaml/*.properties glob, so the build cache would see "nothing changed"
         on a genuine frontend source edit and replay a stale dist/**. -->
    <maven.build.cache.enabled>false</maven.build.cache.enabled>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>bun-install</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>bun</executable>
              <workingDirectory>${project.basedir}</workingDirectory>
              <arguments>
                <argument>install</argument>
                <argument>--frozen-lockfile</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>bun-build</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>bun</executable>
              <workingDirectory>${project.basedir}</workingDirectory>
              <arguments>
                <argument>run</argument>
                <argument>build</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>bun-test</id>
            <phase>test</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <!-- exec-maven-plugin has no built-in notion of "this is a test execution" the way
                   surefire does, so neither -DskipTests nor -Dmaven.test.skip does anything to it
                   without this explicit binding to the root pom's own property, which tracks
                   both. -->
              <skip>${gimle.console.skipTests}</skip>
              <executable>bun</executable>
              <workingDirectory>${project.basedir}</workingDirectory>
              <!-- `bun test` (no "run") invokes Bun's own native test runner, which silently
                   ignores package.json's "test" script entirely: ties tests to a completely
                   different (Jest-like) mocking API than real Vitest, missing vi.stubGlobal/vi.mock
                   support real Vitest has. `bun run test` runs the actual "test": "vitest run"
                   script this project is built around (see vitest.config.ts). -->
              <arguments>
                <argument>run</argument>
                <argument>test</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <!-- Copies Vite's own conventional dist/ output (produced by the bun-build execution
               above) into this module's own jar under console/**, for gimle-controlplane to read
               off its classpath at runtime (see ControlPlaneMain). vite.config.ts is untouched:
               Vite has no idea Maven exists. -->
          <execution>
            <id>copy-console-dist</id>
            <phase>process-resources</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}/console</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.basedir}/dist</directory>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
