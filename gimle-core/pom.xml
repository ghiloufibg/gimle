<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.gimle</groupId>
    <artifactId>gimle</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>gimle-core</artifactId>
  <packaging>jar</packaging>

  <name>Gimle Core</name>
  <description>Shared model/domain types and exceptions used across all Gimle modules.</description>

  <dependencies>
    <!-- Compile-scope (not runtime-only anymore): gimle-core's own com.gimle.core.logging package
         hand-rolls a JSON Encoder and two file Appenders directly against the Logback API, plus
         MDC tagging via slf4j-api. gimle-core still hosts the one
         central logback.xml (src/main/resources), which every module gets transitively on its
         runtime classpath without redeclaring it. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <!-- The default resources dir, kept unfiltered and listed explicitly: declaring <resources>
           at all replaces Maven's own implicit default, so this entry has to stay even though its
           values match that default. logback.xml and the banner templates below must never go
           through ${*} substitution (see gimle-version.properties's own comment for why). -->
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
      </resource>
      <!-- Filtered separately: gimle-version.properties is the only resource that should ever see
           Maven property substitution. -->
      <resource>
        <directory>src/main/resources-filtered</directory>
        <filtering>true</filtering>
      </resource>
    </resources>
    <plugins>
      <!-- Publishes TestMdcExtension, its META-INF/services registration, and logback-test.xml
           as a test-jar so every downstream module gets test-log correlation by adding one
           test-scope dependency, rather than duplicating these three files in each module. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>test-jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
