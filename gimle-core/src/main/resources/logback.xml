<?xml version="1.0" encoding="UTF-8"?>
<!--
  The one central Logback config for the whole project (see CLAUDE.md's logging convention).
  Every module gets this transitively via its dependency on gimle-core; nothing else should ship
  its own logback.xml.
-->
<configuration>
  <!-- ConsoleLogEncoder picks JSON or colored plain-text per process at startup, not here: see
       that class's own javadoc for why JSON has to stay the auto-detected default whenever this
       process's stdout is piped or redirected (worker subprocesses drained live by
       WorkerProcessSupervisor.drainOutput, or any process gimle-maven-plugin spawns) and pretty
       only kicks in for a directly-run process on a real interactive terminal. Independent of the
       file appenders GimleLogging attaches programmatically, which always stay JSON. -->
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder class="com.gimle.core.logging.ConsoleLogEncoder"/>
  </appender>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
  </root>
</configuration>
