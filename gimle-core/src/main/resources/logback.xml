<?xml version="1.0" encoding="UTF-8"?>
<!--
  The one central Logback config for the whole project (see CLAUDE.md's logging convention).
  Every module gets this transitively via its dependency on gimle-core; nothing else should ship
  its own logback.xml.
-->
<configuration>
  <!-- JSON, not the plain-text pattern this used to be (log-explorer-design.md §4): every
       process's SYSTEM-capture fallback (WorkerProcessSupervisor.drainOutput) tells a structured
       line apart from raw output by attempting to JSON-parse it, so console/stdout output has to
       be JSON too, not just the file appenders GimleLogging attaches programmatically. -->
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder class="com.gimle.core.logging.JsonLogEncoder"/>
  </appender>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
  </root>
</configuration>
