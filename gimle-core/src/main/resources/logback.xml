<?xml version="1.0" encoding="UTF-8"?>
<!--
  The one central Logback config for the whole project (see CLAUDE.md's logging convention).
  Every module gets this transitively via its dependency on gimle-core; nothing else should ship
  its own logback.xml.
-->
<configuration>
  <!-- ConsoleLogEncoder picks JSON or colored text per process at startup, not here: see that
       class's own javadoc. Default is colored text, unconditionally: every process already
       writes a complete, unconditional JSON trail to its own file via the PlatformFileAppender
       GimleLogging attaches programmatically (independent of this appender entirely), so nothing
       structured depends on CONSOLE's own format. The one exception is a worker spawned as a
       supervised subprocess, which AgentMain forces back to JSON with an explicit
       -Dgimle.log.console=json rather than relying on this appender to guess. -->
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder class="com.gimle.core.logging.ConsoleLogEncoder"/>
  </appender>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
  </root>
</configuration>
