          <!--
            Every image above was produced by ${java.home}'s own jlink, which builds a runtime for
            the machine it runs on and no other. A Windows-built archive carries Windows binaries
            under jre/, which a Linux cluster machine cannot execute, and nothing about the archive
            itself would have said so. This stops the build when the runtime being bundled isn't
            the one these archives are being built for, so that mismatch can never leave a
            developer's machine unnoticed, and stamps the answer into jre/PLATFORM inside every
            archive that bundles a runtime, so an unpacked archive says which machines its own jre/
            is for and each wrapper script can name it when the bundled runtime turns out not to
            run.

            The platform is read from the building JDK's own release file rather than from a
            produced image's: jlink writes only JAVA_VERSION and MODULES into the release file of
            the image it creates, and the two are the same platform by construction anyway, since
            jlink cannot build an image for anything but its own JDK's.
          -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <executions>
              <execution>
                <id>verify-bundled-jre-platform</id>
                <phase>prepare-package</phase>
                <goals>
                  <goal>run</goal>
                </goals>
                <configuration>
                  <target>
                    <!-- A release file spells every value in quotes; stripping them lets the
                         comparison below be against the plain platform names this pom's own
                         properties carry. Every value is prefixed rather than loaded bare, so
                         nothing here can collide with a Maven property of the same name. -->
                    <loadproperties srcFile="${java.home}/release" prefix="bundledJre.">
                      <filterchain>
                        <tokenfilter>
                          <replacestring from="&quot;" to=""/>
                        </tokenfilter>
                      </filterchain>
                    </loadproperties>
                    <fail
                        unless="bundledJre.OS_NAME"
                        message="${java.home}/release records no OS_NAME, so which platform its jlink builds runtime images for cannot be established. Build the dist-with-jre profile with a JDK whose release file records OS_NAME/OS_ARCH, or build without the profile (no runtime is bundled then, and the archives run anywhere a JDK 25+ is installed)."/>
                    <condition property="bundledJre.matchesTarget">
                      <and>
                        <equals arg1="${bundledJre.OS_NAME}" arg2="${gimle.dist.jre.targetOsName}"/>
                        <equals arg1="${bundledJre.OS_ARCH}" arg2="${gimle.dist.jre.targetOsArch}"/>
                      </and>
                    </condition>
                    <!-- The message is an attribute, not nested text: Ant expands a task's nested
                         text when the build file is parsed, which is before loadproperties above
                         has run, so the platform names would come out as literal ${...} in the one
                         message that most needs them. ${line.separator} keeps it readable. -->
                    <fail
                        unless="bundledJre.matchesTarget"
                        message="-P dist-with-jre bundled a ${bundledJre.OS_NAME}-${bundledJre.OS_ARCH} runtime, but these archives target ${gimle.dist.jre.targetOsName}-${gimle.dist.jre.targetOsArch}.${line.separator}jlink builds a runtime image for the machine it runs on and no other, so this build would ship a jre/ the target machines cannot execute.${line.separator}Build on a machine (or container) of the target platform, or pass -Dgimle.dist.jre.targetOsName=${bundledJre.OS_NAME} -Dgimle.dist.jre.targetOsArch=${bundledJre.OS_ARCH} to declare that this really is what you are building for.${line.separator}The default build (no -P dist-with-jre) bundles no runtime at all and its archives run anywhere a JDK 25+ is already installed."/>
                    <echo
                        file="${project.build.directory}/jre-images/PLATFORM"
                        message="${bundledJre.OS_NAME}-${bundledJre.OS_ARCH}${line.separator}"/>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-assembly-plugin</artifactId>
            <executions>
