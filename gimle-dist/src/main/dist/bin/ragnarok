#!/bin/sh
# Launches Ragnarök (Gimle's chaos/stress-testing tool) against every jar in this archive's own
# lib/ directory, regardless of the caller's current working directory.
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
lib_dir="$script_dir/../lib"

classpath=
for jar in "$lib_dir"/*.jar; do
  if [ -e "$jar" ]; then
    if [ -z "$classpath" ]; then
      classpath="$jar"
    else
      classpath="$classpath:$jar"
    fi
  fi
done

if [ -z "$classpath" ]; then
  echo "ragnarok: no jars found under $lib_dir" >&2
  exit 1
fi

# Precedence: an explicit JAVA_HOME is a deliberate operator override and always wins; otherwise
# prefer this archive's own bundled jre/ragnarok/ (present only when gimle-dist was built with its
# dist-with-jre profile -- see gimle-docs/docs/reference/distribution.md); otherwise fall back to
# plain "java" on PATH, the same precedence bin/hilmir already establishes.
if [ -n "${JAVA_HOME:-}" ]; then
  java_bin="$JAVA_HOME/bin/java"
  if [ ! -x "$java_bin" ]; then
    echo "ragnarok: JAVA_HOME is set to '$JAVA_HOME' but $java_bin is not an executable file -- fix or unset JAVA_HOME" >&2
    exit 1
  fi
  # An explicit JAVA_HOME overriding a machine's other, correct JDK is exactly the case most likely
  # to point at a too-old one -- caught here, up front, rather than surfacing 30+ seconds later as a
  # bare "class file version 69.0, this version of the Java Runtime only recognizes ... up to 65.0"
  # from deep inside whatever this script launches. Grep for the "... version "N..." line rather
  # than blindly taking -version's first output line: a JAVA_TOOL_OPTIONS/_JAVA_OPTIONS set in the
  # environment makes the JVM print a "Picked up ..." diagnostic line ahead of the real one.
  java_version_line=$("$java_bin" -version 2>&1 | grep 'version "' | head -n 1)
  java_major=$(printf '%s\n' "$java_version_line" | sed -n 's/.*version "\([0-9]*\).*/\1/p')
  if [ -z "$java_major" ] || [ "$java_major" -lt 25 ] 2>/dev/null; then
    echo "ragnarok: JAVA_HOME is set to '$JAVA_HOME', but $java_bin reports '$java_version_line' -- Gimlé requires JDK 25+; point JAVA_HOME at a JDK 25+ install or unset it" >&2
    exit 1
  fi
elif [ -d "$script_dir/../jre/ragnarok" ]; then
  java_bin="$script_dir/../jre/ragnarok/bin/java"
  # A bundled runtime only ever runs on the one platform it was built for (jre/PLATFORM records
  # which), and an archive travels further than the machine that built it. Falling through to PATH
  # without a word is what turns that into a bare "java: not found" further down; say what was
  # found, and why it is being ignored, instead.
  if [ ! -x "$java_bin" ] || ! "$java_bin" -version >/dev/null 2>&1; then
    bundled_platform=$(cat "$script_dir/../jre/PLATFORM" 2>/dev/null || true)
    echo "ragnarok: this archive's bundled JRE (built for ${bundled_platform:-an unrecorded platform}) does not run on this machine ($(uname -s 2>/dev/null || echo unknown)-$(uname -m 2>/dev/null || echo unknown)) -- ignoring it and looking for a java of this machine's own" >&2
    java_bin=java
  fi
else
  java_bin=java
fi

if [ "$java_bin" = java ] && ! command -v java >/dev/null 2>&1; then
  echo "ragnarok: no Java runtime to run on -- put a JDK 25+ 'java' on PATH, or set JAVA_HOME to a JDK 25+ install" >&2
  exit 1
fi

exec "$java_bin" -cp "$classpath" com.gimle.ragnarok.RagnarokMain "$@"
