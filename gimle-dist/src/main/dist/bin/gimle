#!/bin/sh
# Launches the gimle CLI against every jar in this archive's own lib/ directory, regardless of the
# caller's current working directory.
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
lib_dir="$script_dir/../lib"

classpath=
for jar in "$lib_dir"/*.jar; do
  if [ -e "$jar" ]; then
    if [ -z "$classpath" ]; then
      classpath="$jar"
    else
      classpath="$classpath:$jar"
    fi
  fi
done

if [ -z "$classpath" ]; then
  echo "gimle: no jars found under $lib_dir" >&2
  exit 1
fi

# Precedence: an explicit JAVA_HOME is a deliberate operator override and always wins; otherwise
# prefer this archive's own bundled jre/cli/ (present only when gimle-dist was built with its
# dist-with-jre profile -- see gimle-docs/docs/reference/distribution.md); otherwise fall back to
# plain "java" on PATH, exactly as before this archive ever bundled a JRE of its own.
if [ -n "${JAVA_HOME:-}" ]; then
  java_bin="$JAVA_HOME/bin/java"
elif [ -x "$script_dir/../jre/cli/bin/java" ]; then
  java_bin="$script_dir/../jre/cli/bin/java"
else
  java_bin=java
fi

exec "$java_bin" -cp "$classpath" com.gimle.cli.GimleCli "$@"
