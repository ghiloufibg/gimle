#!/bin/sh
# Launches Ivaldi (the cluster designer's backend) against every jar in this archive's own lib/
# directory, regardless of the caller's current working directory. IvaldiMain reads no positional
# arguments at all, only -D system properties (gimle.ivaldi.port/dataRoot/host -- see
# gimle-docs/docs/reference/maven-plugin-goals.md's own mvn gimle:ivaldi section for the full
# list), so unlike bin/gimle/bin/hilmir this script places "$@" before the main class on the java
# command line rather than after it: a -D flag is a JVM option, not a program argument, and only
# ever takes effect there.
#   ivaldi -Dgimle.ivaldi.port=9097 -Dgimle.ivaldi.dataRoot=/var/lib/gimle-ivaldi
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
lib_dir="$script_dir/../lib"

classpath=
for jar in "$lib_dir"/*.jar; do
  if [ -e "$jar" ]; then
    if [ -z "$classpath" ]; then
      classpath="$jar"
    else
      classpath="$classpath:$jar"
    fi
  fi
done

if [ -z "$classpath" ]; then
  echo "ivaldi: no jars found under $lib_dir" >&2
  exit 1
fi

# Precedence: an explicit JAVA_HOME is a deliberate operator override and always wins; otherwise
# prefer this archive's own bundled jre/ivaldi/ (present only when gimle-dist was built with its
# dist-with-jre profile -- see gimle-docs/docs/reference/distribution.md); otherwise fall back to
# plain "java" on PATH, exactly as before this archive ever bundled a JRE of its own.
if [ -n "${JAVA_HOME:-}" ]; then
  java_bin="$JAVA_HOME/bin/java"
  if [ ! -x "$java_bin" ]; then
    echo "ivaldi: JAVA_HOME is set to '$JAVA_HOME' but $java_bin is not an executable file -- fix or unset JAVA_HOME" >&2
    exit 1
  fi
  # An explicit JAVA_HOME overriding a machine's other, correct JDK is exactly the case most likely
  # to point at a too-old one -- caught here, up front, rather than surfacing later as a bare "class
  # file version 69.0, this version of the Java Runtime only recognizes ... up to 65.0" from deep
  # inside whatever this script launches. Grep for the "... version "N..." line rather than blindly
  # taking -version's first output line: a JAVA_TOOL_OPTIONS/_JAVA_OPTIONS set in the environment
  # makes the JVM print a "Picked up ..." diagnostic line ahead of the real one.
  java_version_line=$("$java_bin" -version 2>&1 | grep 'version "' | head -n 1)
  java_major=$(printf '%s\n' "$java_version_line" | sed -n 's/.*version "\([0-9]*\).*/\1/p')
  if [ -z "$java_major" ] || [ "$java_major" -lt 25 ] 2>/dev/null; then
    echo "ivaldi: JAVA_HOME is set to '$JAVA_HOME', but $java_bin reports '$java_version_line' -- Gimlé requires JDK 25+; point JAVA_HOME at a JDK 25+ install or unset it" >&2
    exit 1
  fi
elif [ -x "$script_dir/../jre/ivaldi/bin/java" ]; then
  java_bin="$script_dir/../jre/ivaldi/bin/java"
else
  java_bin=java
fi

exec "$java_bin" -cp "$classpath" "$@" com.gimle.ivaldi.IvaldiMain
