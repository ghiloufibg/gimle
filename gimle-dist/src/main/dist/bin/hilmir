#!/bin/sh
# Launches Hilmir (Gimle's cluster bootstrap/deployment tool) against every jar in this archive's
# own lib/ directory, regardless of the caller's current working directory.
#
# Whatever classpath is built here becomes the default classpath LaunchPlanner writes into every
# process command "hilmir up" spawns (StoreMain, ControlPlaneMain, AgentMain, WorkerMain, and the
# rest), unless a topology document sets runtime.classpath itself: HilmirMain falls back to the
# running JVM's own java.class.path when a topology leaves that field unset, so this script's own
# -cp argument doubles as the default classpath every role launches with.
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
lib_dir="$script_dir/../lib"

classpath=
for jar in "$lib_dir"/*.jar; do
  if [ -e "$jar" ]; then
    if [ -z "$classpath" ]; then
      classpath="$jar"
    else
      classpath="$classpath:$jar"
    fi
  fi
done

if [ -z "$classpath" ]; then
  echo "hilmir: no jars found under $lib_dir" >&2
  exit 1
fi

# Precedence: an explicit JAVA_HOME is a deliberate operator override and always wins; otherwise
# prefer this archive's own bundled jre/hilmir/ (present only when gimle-dist was built with its
# dist-with-jre profile -- see gimle-docs/docs/reference/distribution.md); otherwise fall back to
# plain "java" on PATH, exactly as before this archive ever bundled a JRE of its own. This choice is
# purely about which java launches hilmir itself -- it is unrelated to runtime.useBundledJre, the
# separate topology-level setting controlling which java LaunchPlanner picks for each *spawned*
# process (store/muninn/andvari/fafnir/control-plane; never agent/worker -- see
# gimle-docs/docs/reference/hilmir-reference.md).
if [ -n "${JAVA_HOME:-}" ]; then
  java_bin="$JAVA_HOME/bin/java"
  if [ ! -x "$java_bin" ]; then
    echo "hilmir: JAVA_HOME is set to '$JAVA_HOME' but $java_bin is not an executable file -- fix or unset JAVA_HOME" >&2
    exit 1
  fi
  # An explicit JAVA_HOME overriding a machine's other, correct JDK is exactly the case most likely
  # to point at a too-old one -- caught here, up front, rather than surfacing 30+ seconds later as a
  # bare "class file version 69.0, this version of the Java Runtime only recognizes ... up to 65.0"
  # from deep inside whatever this script launches. Grep for the "... version "N..." line rather
  # than blindly taking -version's first output line: a JAVA_TOOL_OPTIONS/_JAVA_OPTIONS set in the
  # environment makes the JVM print a "Picked up ..." diagnostic line ahead of the real one.
  java_version_line=$("$java_bin" -version 2>&1 | grep 'version "' | head -n 1)
  java_major=$(printf '%s\n' "$java_version_line" | sed -n 's/.*version "\([0-9]*\).*/\1/p')
  if [ -z "$java_major" ] || [ "$java_major" -lt 25 ] 2>/dev/null; then
    echo "hilmir: JAVA_HOME is set to '$JAVA_HOME', but $java_bin reports '$java_version_line' -- Gimlé requires JDK 25+; point JAVA_HOME at a JDK 25+ install or unset it" >&2
    exit 1
  fi
elif [ -x "$script_dir/../jre/hilmir/bin/java" ]; then
  java_bin="$script_dir/../jre/hilmir/bin/java"
else
  java_bin=java
fi

# Lets hilmir locate this archive's own install root (in particular its modules/ directory, a
# sibling of bin/ and lib/) without guessing from java.class.path -- see HilmirMain's own
# --modules-dir resolution for "hilmir enable"/"hilmir disable".
export GIMLE_HOME="$script_dir/.."

exec "$java_bin" -cp "$classpath" com.gimle.hilmir.HilmirMain "$@"
