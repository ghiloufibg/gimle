<assembly xmlns="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.3"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.3 http://maven.apache.org/xsd/assembly-1.1.3.xsd">
  <!--
    The dist-with-jre profile's own variant of hilmir.xml: everything the default descriptor
    already includes, plus jre/hilmir/ (this archive's own dist-with-jre-profile-built jlink JRE for
    gimle-hilmir, from target/jre-images/hilmir/jre). Never used by the default (no-profile) build :
    see the dist-with-jre profile's own comment in ../../../pom.xml for why this is a separate file
    rather than a change to hilmir.xml itself.

    No fileMode is set on the jre/hilmir fileSet, unlike the bin/ one below: an explicit fileMode
    would overwrite the executable bit jlink already set on jre/hilmir/bin/java and friends, so this
    deliberately relies on maven-assembly-plugin's own default of preserving each source file's real
    permissions when no fileMode is given.
  -->
  <id>hilmir</id>
  <formats>
    <format>tar.gz</format>
  </formats>
  <includeBaseDirectory>true</includeBaseDirectory>
  <baseDirectory>gimle-hilmir-${project.version}</baseDirectory>

  <dependencySets>
    <dependencySet>
      <outputDirectory>lib</outputDirectory>
      <useProjectArtifact>false</useProjectArtifact>
      <unpack>false</unpack>
      <scope>runtime</scope>
      <includes>
        <include>com.gimle:gimle-hilmir</include>
        <include>com.gimle:gimle-core</include>
        <include>com.gimle:gimle-mimir</include>
        <include>org.slf4j:slf4j-api</include>
        <include>ch.qos.logback:logback-classic</include>
        <include>ch.qos.logback:logback-core</include>
        <include>org.yaml:snakeyaml</include>
      </includes>
    </dependencySet>
  </dependencySets>

  <fileSets>
    <fileSet>
      <directory>${project.basedir}/src/main/dist/bin</directory>
      <outputDirectory>bin</outputDirectory>
      <fileMode>0755</fileMode>
      <includes>
        <include>hilmir</include>
        <include>hilmir.cmd</include>
      </includes>
    </fileSet>
    <fileSet>
      <directory>${project.build.directory}/jre-images/hilmir/jre</directory>
      <outputDirectory>jre/hilmir</outputDirectory>
    </fileSet>
  </fileSets>

  <!--
    The one file under jre/ that isn't part of any runtime image: the platform every image in this
    archive was built for, written by the dist-with-jre profile's own verify-bundled-jre-platform
    step. It is what lets an unpacked archive answer "which machines is this jre/ for?" without
    running anything, and what each bin/ wrapper names when the bundled runtime turns out not to
    run here.
  -->
  <files>
    <file>
      <source>${project.build.directory}/jre-images/PLATFORM</source>
      <outputDirectory>jre</outputDirectory>
      <destName>PLATFORM</destName>
    </file>
  </files>
</assembly>
