<assembly xmlns="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.3"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.3 http://maven.apache.org/xsd/assembly-1.1.3.xsd">
  <!--
    The standalone Ragnarok archive: bin/ragnarok plus exactly gimle-ragnarok's own runtime
    dependency closure, nothing else; confirmed via `mvn -pl gimle-ragnarok dependency:tree
    -Dscope=runtime`. gimle-testkit is part of that closure even though its name suggests test
    tooling: Heimdall (the condition-polling harness ClusterTarget.when() returns) is load-bearing
    library code for Fenrir/Surtr at runtime here, not test-only. gimle-ragnarok-pause is
    deliberately absent from this list: it ships embedded inside gimle-ragnarok's own jar (see
    gimle-ragnarok/pom.xml's maven-dependency-plugin copy execution), never as a sibling lib jar.
  -->
  <id>ragnarok</id>
  <formats>
    <format>tar.gz</format>
  </formats>
  <includeBaseDirectory>true</includeBaseDirectory>
  <baseDirectory>gimle-ragnarok-${project.version}</baseDirectory>

  <dependencySets>
    <dependencySet>
      <outputDirectory>lib</outputDirectory>
      <useProjectArtifact>false</useProjectArtifact>
      <unpack>false</unpack>
      <scope>runtime</scope>
      <includes>
        <include>com.gimle:gimle-ragnarok</include>
        <include>com.gimle:gimle-core</include>
        <include>com.gimle:gimle-testkit</include>
        <include>com.gimle:gimle-mimir</include>
        <include>com.gimle:gimle-module</include>
        <include>com.gimle:gimle-hilmir</include>
        <include>org.slf4j:slf4j-api</include>
        <include>ch.qos.logback:logback-classic</include>
        <include>ch.qos.logback:logback-core</include>
        <include>org.yaml:snakeyaml</include>
      </includes>
    </dependencySet>
  </dependencySets>

  <fileSets>
    <fileSet>
      <directory>${project.basedir}/src/main/dist/bin</directory>
      <outputDirectory>bin</outputDirectory>
      <fileMode>0755</fileMode>
      <includes>
        <include>ragnarok</include>
        <include>ragnarok.cmd</include>
      </includes>
    </fileSet>
  </fileSets>
</assembly>
