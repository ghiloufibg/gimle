<component xmlns="http://maven.apache.org/plugins/maven-assembly-plugin/component/1.1.3"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://maven.apache.org/plugins/maven-assembly-plugin/component/1.1.3 http://maven.apache.org/xsd/component-1.1.3.xsd">
  <!--
    The cluster-machine jar layout shared by every archive that runs a full cluster (platform,
    platform-with-jre, midgard): every process-kind jar plus hilmir/gimle themselves and their
    runtime dependency closure in one flat lib/ directory (the single classpath every role's own
    launch command, generated by hilmir's own LaunchPlanner, points at), and gimle-gateway's jar
    under modules/ where nothing puts it on a classpath (it is a hosted module, not a process
    kind). One shared component rather than a copy per descriptor, so a change to the cluster jar
    layout cannot land in one archive and silently miss another.
  -->
  <dependencySets>
    <dependencySet>
      <outputDirectory>lib</outputDirectory>
      <useProjectArtifact>false</useProjectArtifact>
      <useTransitiveDependencies>true</useTransitiveDependencies>
      <unpack>false</unpack>
      <scope>runtime</scope>
      <excludes>
        <exclude>com.gimle:gimle-gateway</exclude>
      </excludes>
    </dependencySet>
    <dependencySet>
      <outputDirectory>modules</outputDirectory>
      <useProjectArtifact>false</useProjectArtifact>
      <useTransitiveDependencies>false</useTransitiveDependencies>
      <unpack>false</unpack>
      <scope>runtime</scope>
      <includes>
        <include>com.gimle:gimle-gateway</include>
      </includes>
    </dependencySet>
  </dependencySets>
</component>
