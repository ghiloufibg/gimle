<assembly xmlns="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.3"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.3 http://maven.apache.org/xsd/assembly-1.1.3.xsd">
  <!--
    The dist-with-jre profile's own variant of cli.xml: everything the default descriptor already
    includes, plus jre/cli/ (this archive's own dist-with-jre-profile-built jlink JRE for
    gimle-cli, from target/jre-images/cli/jre). Never used by the default (no-profile) build: see
    the dist-with-jre profile's own comment in ../../../pom.xml for why this is a separate file
    rather than a change to cli.xml itself.

    No fileMode is set on the jre/cli fileSet, unlike the bin/ one below: an explicit fileMode would
    overwrite the executable bit jlink already set on jre/cli/bin/java and friends, so this
    deliberately relies on maven-assembly-plugin's own default of preserving each source file's real
    permissions when no fileMode is given.
  -->
  <id>cli</id>
  <formats>
    <format>tar.gz</format>
  </formats>
  <includeBaseDirectory>true</includeBaseDirectory>
  <baseDirectory>gimle-cli-${project.version}</baseDirectory>

  <dependencySets>
    <dependencySet>
      <outputDirectory>lib</outputDirectory>
      <useProjectArtifact>false</useProjectArtifact>
      <unpack>false</unpack>
      <scope>runtime</scope>
      <includes>
        <include>com.gimle:gimle-cli</include>
        <!-- The terminal cluster view, `gimle top`, contributed as a CliExtension provider that
             ServiceLoader finds on this classpath. Take these three jars out and the verb goes
             back to being an unknown one; nothing else in the archive changes. -->
        <include>com.gimle:gimle-hugin</include>
        <include>org.jline:jline-terminal</include>
        <include>org.jline:jline-terminal-ffm</include>
        <include>com.gimle:gimle-core</include>
        <include>com.gimle:gimle-module</include>
        <include>com.gimle:gimle-pki</include>
        <include>org.slf4j:slf4j-api</include>
        <include>ch.qos.logback:logback-classic</include>
        <include>ch.qos.logback:logback-core</include>
        <include>org.yaml:snakeyaml</include>
        <include>org.bouncycastle:bcpkix-jdk18on</include>
        <include>org.bouncycastle:bcutil-jdk18on</include>
        <include>org.bouncycastle:bcprov-jdk18on</include>
      </includes>
    </dependencySet>
  </dependencySets>

  <fileSets>
    <fileSet>
      <directory>${project.basedir}/src/main/dist/bin</directory>
      <outputDirectory>bin</outputDirectory>
      <fileMode>0755</fileMode>
      <includes>
        <include>gimle</include>
        <include>gimle.cmd</include>
      </includes>
    </fileSet>
    <fileSet>
      <directory>${project.build.directory}/jre-images/cli/jre</directory>
      <outputDirectory>jre/cli</outputDirectory>
    </fileSet>
  </fileSets>
</assembly>
