<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.gimle</groupId>
    <artifactId>gimle</artifactId>
    <version>0.1.0-alpha.2</version>
  </parent>

  <artifactId>gimle-agent</artifactId>
  <packaging>jar</packaging>

  <name>Gimle Agent</name>
  <description>
    Node agent: worker spawning via the Process API, resource assignment, supervision
    and restart, capacity reporting. Never runs hosted-module code itself.
  </description>

  <properties>
    <!-- Runtime-image profile (root pom): the JDK platform module list was arrived at
         empirically: jlink + run AgentMain, add whatever module a NoClassDefFoundError
         named, repeat; not derived from module-info.java's own requires list alone. -->
    <gimle.runtimeImage.launcherClass>com.gimle.agent.AgentMain</gimle.runtimeImage.launcherClass>
    <gimle.runtimeImage.jdkModules>java.base,java.net.http,java.management,jdk.management,java.logging,java.xml,java.naming</gimle.runtimeImage.jdkModules>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.gimle</groupId>
      <artifactId>gimle-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.gimle</groupId>
      <artifactId>gimle-core</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.gimle</groupId>
      <artifactId>gimle-os</artifactId>
    </dependency>
    <dependency>
      <groupId>com.gimle</groupId>
      <artifactId>gimle-module</artifactId>
    </dependency>
    <dependency>
      <groupId>com.gimle</groupId>
      <artifactId>gimle-fabric</artifactId>
    </dependency>
    <!-- Generates this agent's own CSR at first bootstrap and its rotation CSRs later; never
         signs anything itself, that's gimle-controlplane's job. -->
    <dependency>
      <groupId>com.gimle</groupId>
      <artifactId>gimle-pki</artifactId>
    </dependency>
    <!-- MuninnShipper: ships this agent's own logs, plus every supervised worker's, to Muninn
         when -Dgimle.agent.muninnEndpoint is configured. The agent's first genuine main-scope
         need for anything in gimle-observability, which had only ever been a test-scope
         dependency (via gimle-worker) before this. -->
    <dependency>
      <groupId>com.gimle</groupId>
      <artifactId>gimle-observability</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.gimle</groupId>
      <artifactId>gimle-worker</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.gimle</groupId>
      <artifactId>gimle-controlplane</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.gimle</groupId>
      <artifactId>gimle-module</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <!--
      gimle-controlplane's own ApiServer talks to Fafnir purely over HTTP (FafnirClient), so it
      carries no compile-scope dependency on gimle-fafnir itself. These integration tests need a
      real, in-process FafnirServer standing behind that ApiServer, so this module needs the
      dependency explicitly, test-scoped.
    -->
    <dependency>
      <groupId>com.gimle</groupId>
      <artifactId>gimle-fafnir</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Await and PortLease: shared test infrastructure so this module's own tests don't
         reimplement condition-polling or port-leasing helpers already canonical there. -->
    <dependency>
      <groupId>com.gimle</groupId>
      <artifactId>gimle-testkit</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        Two independent, redundant defenses against WorkerStartupBenchIT ever running under plain
        mvn verify, copied verbatim from gimle-holmgang/gimle-smoke-tests, where an unqualified
        -Dtest='!A,!B,...' (exclusions only, no positive pattern) was observed to broaden
        Surefire's own default class discovery enough to pick an *IT class up anyway: the excludes
        pattern alone is not enough, and JUnit 5's tag-based excludedGroups filtering is a separate
        mechanism unaffected by that override. Every concrete *IT class in this module carries
        @Tag("aotbench") for exactly this. Plain unit tests still run under the default build.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>**/*IT.java</exclude>
          </excludes>
          <excludedGroups>aotbench</excludedGroups>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>aotbench</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <executions>
              <execution>
                <goals>
                  <goal>integration-test</goal>
                  <goal>verify</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
