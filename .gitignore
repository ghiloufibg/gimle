target/
*.class
*.log
claudedocs/

# maven-profiler's own report output (.mvn/extensions.xml), written at the reactor root when a
# build runs with -Dprofile -- regenerated per profiled build, not authored content.
.profiler/

# mvn gimle:bootstrap's own state dir (store raft state, control-plane secret key, TLS material) --
# not under target/, and contains non-.log files the blanket *.log rule above doesn't catch.
gimle-bootstrap/

# Claude Code's own worktree-isolation bookkeeping for parallel background agents -- ephemeral
# harness state, not authored content.
.claude/

# gimle-console (npm/Vite-family project, outside the Maven reactor) build artifacts
gimle-console/node_modules/
gimle-console/dist/
gimle-console/.output/
console-dist/

# gimle-fafnir-console -- same reasoning as gimle-console above.
gimle-fafnir-console/node_modules/
gimle-fafnir-console/dist/

# gimle-docs (Docusaurus/Bun-family project) build artifacts, including the aggregate Javadoc
# copied into static/javadoc/ by gimle-docs/pom.xml's copy-javadoc-static execution -- regenerated
# output, not authored content, same reasoning as gimle-console/dist/ above.
gimle-docs/node_modules/
gimle-docs/build/
gimle-docs/.docusaurus/
gimle-docs/static/javadoc/
