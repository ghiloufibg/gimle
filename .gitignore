target/
*.class
*.log
claudedocs/

# maven-profiler's own report output (.mvn/extensions.xml), written at the reactor root when a
# build runs with -Dprofile -- regenerated per profiled build, not authored content.
.profiler/

# mvn gimle:bootstrap's own state dir (store raft state, control-plane secret key, TLS material) --
# not under target/, and contains non-.log files the blanket *.log rule above doesn't catch.
gimle-bootstrap/

# Claude Code's own worktree-isolation bookkeeping and local settings -- ephemeral harness
# state, not authored content. Project skills under .claude/skills/ ARE authored content and
# stay tracked (the un-ignore only works with a wildcard pattern, not a bare directory ignore).
.claude/*
!.claude/skills/

# maven-build-cache-extension writing to a literal, unexpanded "${user.home}" directory instead of
# resolving .mvn/maven-build-cache-config.xml's ${user.home} placeholder -- a sandbox-specific
# property-resolution quirk, not a repo config bug; ignored defensively so it can't land in a commit.
${user.home}/

# gimle-console (npm/Vite-family project, outside the Maven reactor) build artifacts
gimle-console/node_modules/
gimle-console/dist/
gimle-console/.output/
console-dist/

# gimle-fafnir-console -- same reasoning as gimle-console above.
gimle-fafnir-console/node_modules/
gimle-fafnir-console/dist/

# gimle-docs (Docusaurus/Bun-family project) build artifacts, including the aggregate Javadoc
# copied into static/javadoc/ by gimle-docs/pom.xml's copy-javadoc-static execution -- regenerated
# output, not authored content, same reasoning as gimle-console/dist/ above.
gimle-docs/node_modules/
gimle-docs/build/
gimle-docs/.docusaurus/
gimle-docs/static/javadoc/

# qa-manual-validation -- a local hand-run QA cluster (Docker Compose + unpacked gimle-dist
# archives + built gimle-examples jars), regenerated from a real build rather than authored
# content meant for the repo, and large (unpacked distributions + a dozen-plus jars).
qa-manual-validation/
