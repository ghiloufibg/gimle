  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Needed to implement LauncherSessionListener (gimle-core's EagerSlf4jBindingInitializer):
         forces SLF4J's one-time binding to finish before any parallel test class touches it. -->
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.2</version>
          <configuration>
            <forkCount>1</forkCount>
            <reuseForks>true</reuseForks>
            <!-- Tests run on the classpath as an unnamed module even though main is
                 modular: gimle-module's tests build ModuleLayers dynamically at runtime,
                 which is unrelated to (and easier without) surefire's own module-patch
                 execution mode. Also: a fixture module resolved as a *real* JPMS module
                 into its own layer gets a fresh Class object for anything it `requires`,
                 even a module gimle-module itself already has loaded — so cross-checking a
                 dynamically-loaded hook against gimle-module's own ModuleLifecycleHooks
                 interface only works if gimle-module runs unnamed here, not module-path. -->
            <useModulePath>false</useModulePath>
            <!-- Required before enabling class-level concurrency below: without this, concurrent
                 classes interleave raw stdout/stderr nondeterministically, which is exactly the
                 debuggability regression parallel execution would otherwise cause. Each class's
                 captured output lands in its own file under target/surefire-reports/ regardless
                 of what else was running at the same time. -->
            <redirectTestOutputToFile>true</redirectTestOutputToFile>
            <!-- A test that fails once and then passes on retry is reported as flaky (a distinct
                 flakyFailure/flakyError element per attempt, plus a separate "Flakes:" count in
                 the summary), not silently treated as passing outright: the build still fails
                 if a test fails every attempt. Kept at 1, not higher: this is meant to absorb
                 genuine transient flakiness (timing, network, port-reuse-style races), not mask
                 a real bug by retrying it into passing. -->
            <rerunFailingTestsCount>1</rerunFailingTestsCount>
            <!-- Tests carrying @Tag("flaky") (see FLAKY_TESTS.md) are quarantined out of every
                 module's default verify run here, once, rather than per-module; `mvn
                 gimle:flaky-tests` runs them separately, one module at a time. -->
            <excludedGroups>${gimle.excludedGroups}</excludedGroups>
            <!-- rerunFailingTestsCount above already tolerates a single flaky rerun per test, but
                 without a ceiling that tolerance is unlimited: a real regression that flakes
                 rather than fails outright could pass every run forever. 20 is a deliberately
                 generous starting budget for this sandbox's known shared-CPU noise, not a target;
                 ratchet it down as flakes get root-caused and fixed (see FLAKY_TESTS.md), rather
                 than starting at 0 and immediately blocking on today's known flakes. -->
            <failOnFlakeCount>20</failOnFlakeCount>
            <properties>
              <configurationParameters>
                junit.jupiter.execution.parallel.enabled=true
                junit.jupiter.execution.parallel.mode.default=same_thread
                junit.jupiter.execution.parallel.mode.classes.default=concurrent
                junit.jupiter.execution.parallel.config.strategy=dynamic
                junit.jupiter.execution.parallel.config.dynamic.factor=1.0
                junit.jupiter.extensions.autodetection.enabled=true
              </configurationParameters>
            </properties>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>3.5.2</version>
        </plugin>
        <plugin>
          <groupId>com.spotify.fmt</groupId>
          <artifactId>fmt-maven-plugin</artifactId>
          <version>2.29</version>
          <configuration>
            <style>google</style>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-checkstyle-plugin</artifactId>
          <version>3.6.0</version>
          <configuration>
            <configLocation>${maven.multiModuleProjectDirectory}/checkstyle.xml</configLocation>
            <propertyExpansion>config_loc=${maven.multiModuleProjectDirectory}</propertyExpansion>
            <consoleOutput>true</consoleOutput>
            <failOnViolation>true</failOnViolation>
            <violationSeverity>warning</violationSeverity>
            <includeTestSourceDirectory>true</includeTestSourceDirectory>
            <!-- module-info.java isn't a regular compilation unit; Checkstyle's parser rejects it. -->
            <excludes>**/module-info.java</excludes>
          </configuration>
        </plugin>
        <plugin>
          <groupId>com.github.spotbugs</groupId>
          <artifactId>spotbugs-maven-plugin</artifactId>
          <version>4.10.3.0</version>
          <configuration>
            <effort>Max</effort>
            <threshold>Medium</threshold>
            <excludeFilterFile>${maven.multiModuleProjectDirectory}/spotbugs-exclude.xml</excludeFilterFile>
            <failOnError>true</failOnError>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-dependency-plugin</artifactId>
          <version>3.8.1</version>
        </plugin>
        <!--
          Packages a resolved set of reactor/transitive dependencies into a directory-shaped
          archive (tar.gz), used by gimle-dist to build the platform/CLI/hilmir distribution
          tarballs from assembly descriptors under gimle-dist/src/main/assembly.
        -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-assembly-plugin</artifactId>
          <version>3.7.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.4.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>3.3.1</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <version>3.5.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-antrun-plugin</artifactId>
          <version>3.1.0</version>
        </plugin>
        <!--
          Deliberately declared here only, never bound to a lifecycle phase or added under
          <build><plugins>: `aggregate` needs the full reactor project list, which a direct goal
          invocation against this root aggregator POM (`mvn javadoc:aggregate`, or `mvn gimle:docs`
          via gimle-maven-plugin's DocsMojo) gets for free, the same "direct goal, no bound phase"
          shape gimle-maven-plugin's own goals already use, and for the same reason (see
          gimle-maven-plugin/src/main/java/com/gimle/mavenplugin/AbstractGimleMojo.java's javadoc).

          Include/exclude enforcement (only the actual platform API surface, not
          gimle-maven-plugin/gimle-examples/gimle-smoke-tests) is done via a per-module
          `maven.javadoc.skip=true` property on each excluded module's own pom, not via
          <sourcepath> here: an earlier attempt at overriding <sourcepath>/<subpackages> to hand-list
          only the included modules' src/main/java directories was tried and reverted: it silently
          throws away the reactor-derived classpath aggregate normally builds automatically from
          every included project's own resolved dependencies, which real `module-info.java` `requires`
          directives (org.slf4j, ch.qos.logback.classic, etc.) need to actually resolve; confirmed by
          hitting exactly that failure directly ("module not found: org.slf4j") before switching to
          the per-module skip-property approach, which keeps automatic reactor-based classpath
          resolution intact for every module that isn't explicitly skipped. gimle-console/gimle-docs
          need no skip property: neither has any src/main/java for javadoc to find in the first
          place.

          <doclint>none</doclint> and <failOnError>false</failOnError> are required, not optional
          tuning: this codebase deliberately favors clear names over Javadoc prose (see CLAUDE.md's
          own comment convention), so most public members carry little or no @param/@return, which
          is exactly the sparse commenting default doclint treats as a hard error.

          No <reportOutputDirectory>/<destDir> override: confirmed empirically that a bare direct
          `mvn javadoc:aggregate` invocation ignores those two params when only declared here in
          pluginManagement (unlike doclint/failOnError/release, which are honored) and always
          writes to the plugin's own real default, target/reports/apidocs. gimle-docs/pom.xml's own
          javadoc-copy step points at that path for exactly this reason, not a customized one.
        -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-javadoc-plugin</artifactId>
          <version>3.11.2</version>
          <configuration>
            <doclint>none</doclint>
            <failOnError>false</failOnError>
            <release>25</release>
          </configuration>
        </plugin>
        <!--
          CycloneDX SBOM generation, offline only: reads the reactor's already-resolved
          dependency graph and writes a manifest, no vulnerability-database lookup. Live CVE
          scanning (e.g. OWASP dependency-check) is a deliberate, documented deferral, not an
          oversight: this sandbox's network policy blocks both services.nvd.nist.gov and
          ossindex.sonatype.org, and a tool that can't run here would need to work identically in
          CI anyway, so building against one that can't be exercised locally is the wrong call.
          makeAggregateBom needs the full reactor project list, which only a build against this
          root aggregator gets automatically; bound with inherited=false below so it runs exactly
          once (for this root project itself), not once per child module.
        -->
        <plugin>
          <groupId>org.cyclonedx</groupId>
          <artifactId>cyclonedx-maven-plugin</artifactId>
          <version>2.9.3</version>
          <configuration>
            <outputFormat>json</outputFormat>
            <schemaVersion>1.5</schemaVersion>
            <outputName>bom</outputName>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>com.spotify.fmt</groupId>
        <artifactId>fmt-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.cyclonedx</groupId>
        <artifactId>cyclonedx-maven-plugin</artifactId>
        <inherited>false</inherited>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>makeAggregateBom</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      Opt-in per-role runtime image (CLAUDE.md's own "jlink/jpackage: minimal per-node-role runtime
      images"). Not part of the default build (it's a packaging
      step, not a correctness check), so it only runs when a module both sets
      gimle.runtimeImage.jdkModules/launcherClass (today: gimle-agent, gimle-worker,
      gimle-controlplane) and this profile is explicitly requested, e.g.
      `mvn clean package -pl gimle-agent -P runtime-image` (use `clean`: jlink refuses to write
      into an already-existing output directory; deliberately no `-am`, since `-P` activates a
      requested profile across the whole reactor a build touches, and this profile would fail
      against any ancestor module `-am` pulled in that never sets these properties. Install
      dependencies normally first, then build a specific role's own runtime image on its own.

      jlink here builds a JDK-platform-only runtime, deliberately never asked to add-modules the
      application's own module (com.gimle.agent etc.) or link any of its dependencies:
      investigation confirmed the OpenTelemetry Java SDK ships no real module-info.class anywhere
      in its dependency tree (only Automatic-Module-Name, a deliberate, long-standing upstream
      decision, open-telemetry/opentelemetry-java issue #5052, not something a version bump
      fixes), and jlink categorically refuses to link any automatic module into a runtime image.
      Asking jlink only for the JDK's own platform modules sidesteps that entirely: the
      application and every dependency (modular or not) then run afterward exactly like they do
      today under test, unnamed module, on a classpath, just against this smaller, faster
      starting custom java instead of a full JDK/JRE install. The concrete module list per role
      was arrived at empirically (jlink + run each role's Main with insufficient args, add
      whatever JDK module the resulting NoClassDefFoundError named, repeat) rather than derived
      from module-info.java's own requires list alone: Logback's XML config parsing alone
      needed java.xml and java.naming, neither of which any gimle-* module-info mentions.
    -->
    <profile>
      <id>runtime-image</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <executions>
              <execution>
                <id>runtime-image-copy-deps</id>
                <phase>package</phase>
                <goals>
                  <goal>copy-dependencies</goal>
                </goals>
                <configuration>
                  <includeScope>runtime</includeScope>
                  <outputDirectory>${project.build.directory}/runtime-image/lib</outputDirectory>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>runtime-image-jlink</id>
                <phase>package</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>${java.home}/bin/jlink</executable>
                  <arguments>
                    <argument>--add-modules</argument>
                    <argument>${gimle.runtimeImage.jdkModules}</argument>
                    <argument>--output</argument>
                    <argument>${project.build.directory}/runtime-image/jre</argument>
                    <argument>--strip-debug</argument>
                    <argument>--no-header-files</argument>
                    <argument>--no-man-pages</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <executions>
              <execution>
                <id>runtime-image-run-instructions</id>
                <phase>package</phase>
                <goals>
                  <goal>run</goal>
                </goals>
                <configuration>
                  <target>
                    <echo file="${project.build.directory}/runtime-image/RUN.txt">Launch with:
  ${project.build.directory}/runtime-image/jre/bin/java -cp "${project.build.directory}/${project.build.finalName}.jar${path.separator}${project.build.directory}/runtime-image/lib/*" ${gimle.runtimeImage.launcherClass} [args...]
</echo>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!--
      Opt-in reactor membership for gimle-docs (the developer documentation site, Docusaurus/Bun).
      Generating an aggregate Javadoc across nine modules plus a full Docusaurus build is real
      wall-clock cost with no payoff on every routine `mvn verify`,
      so, unlike gimle-console, which is always in the default `<modules>` list, gimle-docs
      only joins the reactor when this profile is active: `mvn verify` never touches it; `mvn
      verify -P docs` (or `-P docs -pl gimle-docs -am`) builds everything and the site. Unlike the
      runtime-image profile above (which only adds plugin executions to modules already in the
      reactor), this profile changes reactor *membership* itself, via Maven's per-profile
      <modules> support.
    -->
    <profile>
      <id>docs</id>
      <modules>
        <module>gimle-docs</module>
      </modules>
    </profile>
  </profiles>
</project>
