  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>25</maven.compiler.release>
    <!-- Surefire/failsafe already bind their own -DskipTests handling internally; declaring the
         property here too (default false, overridden by -DskipTests on the command line the same
         way) is what lets gimle-console/gimle-fafnir-console/gimle-andvari-console's own bun-test
         exec-maven-plugin execution reference ${skipTests} and actually honor the flag, since
         exec-maven-plugin has no built-in notion of "this is a test" the way surefire does;
         without an explicit binding, -DskipTests silently has no effect on it at all. -->
    <skipTests>false</skipTests>
    <!-- Bound to Surefire's own excludedGroups below via this indirection (rather than a literal
         "flaky" string) so gimle:flaky-tests can clear it with -Dgimle.excludedGroups= on its own
         child mvn invocation: an explicit POM value always wins over the CLI's ${excludedGroups}
         expression baked into Surefire's own plugin descriptor, so overriding requires going
         through a property this POM itself defines. -->
    <gimle.excludedGroups>flaky</gimle.excludedGroups>
