<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.gimle</groupId>
  <artifactId>gimle</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Gimle</name>
  <description>
    A fully-Java application platform combining Karaf/OSGi's dynamic module lifecycle
    with Kubernetes' declarative orchestration, implemented end to end on the JVM.
  </description>

  <modules>
    <module>gimle-core</module>
    <module>gimle-module</module>
    <module>gimle-os</module>
    <module>gimle-observability</module>
    <module>gimle-worker</module>
    <module>gimle-agent</module>
    <module>gimle-controlplane</module>
    <module>gimle-fabric</module>
    <module>gimle-cli</module>
    <module>gimle-console</module>
    <module>gimle-maven-plugin</module>
    <module>gimle-examples/hello-module</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>25</maven.compiler.release>
    <junit.version>5.11.4</junit.version>
    <snakeyaml.version>2.3</snakeyaml.version>
    <micrometer.version>1.16.3</micrometer.version>
    <slf4j.version>2.0.17</slf4j.version>
    <logback.version>1.5.18</logback.version>
    <opentelemetry.version>1.64.0</opentelemetry.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.micrometer</groupId>
        <artifactId>micrometer-bom</artifactId>
        <version>${micrometer.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.opentelemetry</groupId>
        <artifactId>opentelemetry-bom</artifactId>
        <version>${opentelemetry.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>${slf4j.version}</version>
      </dependency>
      <dependency>
        <groupId>ch.qos.logback</groupId>
        <artifactId>logback-classic</artifactId>
        <version>${logback.version}</version>
      </dependency>
      <dependency>
        <groupId>com.gimle</groupId>
        <artifactId>gimle-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.gimle</groupId>
        <artifactId>gimle-module</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.gimle</groupId>
        <artifactId>gimle-module</artifactId>
        <version>${project.version}</version>
        <type>test-jar</type>
      </dependency>
      <dependency>
        <groupId>com.gimle</groupId>
        <artifactId>gimle-os</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.gimle</groupId>
        <artifactId>gimle-observability</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.gimle</groupId>
        <artifactId>gimle-worker</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.gimle</groupId>
        <artifactId>gimle-agent</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.gimle</groupId>
        <artifactId>gimle-controlplane</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.gimle</groupId>
        <artifactId>gimle-fabric</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.gimle</groupId>
        <artifactId>gimle-cli</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.gimle</groupId>
        <artifactId>gimle-console</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.yaml</groupId>
        <artifactId>snakeyaml</artifactId>
        <version>${snakeyaml.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.2</version>
          <configuration>
            <forkCount>1</forkCount>
            <reuseForks>true</reuseForks>
            <!-- Tests run on the classpath as an unnamed module even though main is
                 modular: gimle-module's tests build ModuleLayers dynamically at runtime,
                 which is unrelated to (and easier without) surefire's own module-patch
                 execution mode. Also: a fixture module resolved as a *real* JPMS module
                 into its own layer gets a fresh Class object for anything it `requires`,
                 even a module gimle-module itself already has loaded — so cross-checking a
                 dynamically-loaded hook against gimle-module's own ModuleLifecycleHooks
                 interface only works if gimle-module runs unnamed here, not module-path. -->
            <useModulePath>false</useModulePath>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>3.5.2</version>
        </plugin>
        <plugin>
          <groupId>com.spotify.fmt</groupId>
          <artifactId>fmt-maven-plugin</artifactId>
          <version>2.29</version>
          <configuration>
            <style>google</style>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-checkstyle-plugin</artifactId>
          <version>3.6.0</version>
          <configuration>
            <configLocation>${maven.multiModuleProjectDirectory}/checkstyle.xml</configLocation>
            <propertyExpansion>config_loc=${maven.multiModuleProjectDirectory}</propertyExpansion>
            <consoleOutput>true</consoleOutput>
            <failOnViolation>true</failOnViolation>
            <violationSeverity>warning</violationSeverity>
            <includeTestSourceDirectory>true</includeTestSourceDirectory>
            <!-- module-info.java isn't a regular compilation unit; Checkstyle's parser rejects it. -->
            <excludes>**/module-info.java</excludes>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-dependency-plugin</artifactId>
          <version>3.8.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.4.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>3.3.1</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <version>3.5.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-antrun-plugin</artifactId>
          <version>3.1.0</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>com.spotify.fmt</groupId>
        <artifactId>fmt-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      Opt-in per-role runtime image (Phase 6 stretch goal, CLAUDE.md's own "jlink/jpackage:
      minimal per-node-role runtime images"). Not part of the default build (it's a packaging
      step, not a correctness check), so it only runs when a module both sets
      gimle.runtimeImage.jdkModules/launcherClass (today: gimle-agent, gimle-worker,
      gimle-controlplane) and this profile is explicitly requested, e.g.
      `mvn clean package -pl gimle-agent -P runtime-image` (use `clean`: jlink refuses to write
      into an already-existing output directory; deliberately no `-am`, since `-P` activates a
      requested profile across the whole reactor a build touches, and this profile would fail
      against any ancestor module `-am` pulled in that never sets these properties. Install
      dependencies normally first, then build a specific role's own runtime image on its own.

      jlink here builds a JDK-platform-only runtime, deliberately never asked to add-modules the
      application's own module (com.gimle.agent etc.) or link any of its dependencies:
      investigation confirmed the OpenTelemetry Java SDK ships no real module-info.class anywhere
      in its dependency tree (only Automatic-Module-Name, a deliberate, long-standing upstream
      decision, open-telemetry/opentelemetry-java issue #5052, not something a version bump
      fixes), and jlink categorically refuses to link any automatic module into a runtime image.
      Asking jlink only for the JDK's own platform modules sidesteps that entirely: the
      application and every dependency (modular or not) then run afterward exactly like they do
      today under test, unnamed module, on a classpath, just against this smaller, faster
      starting custom java instead of a full JDK/JRE install. The concrete module list per role
      was arrived at empirically (jlink + run each role's Main with insufficient args, add
      whatever JDK module the resulting NoClassDefFoundError named, repeat) rather than derived
      from module-info.java's own requires list alone: Logback's XML config parsing alone
      needed java.xml and java.naming, neither of which any gimle-* module-info mentions.
    -->
    <profile>
      <id>runtime-image</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <executions>
              <execution>
                <id>runtime-image-copy-deps</id>
                <phase>package</phase>
                <goals>
                  <goal>copy-dependencies</goal>
                </goals>
                <configuration>
                  <includeScope>runtime</includeScope>
                  <outputDirectory>${project.build.directory}/runtime-image/lib</outputDirectory>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>runtime-image-jlink</id>
                <phase>package</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>${java.home}/bin/jlink</executable>
                  <arguments>
                    <argument>--add-modules</argument>
                    <argument>${gimle.runtimeImage.jdkModules}</argument>
                    <argument>--output</argument>
                    <argument>${project.build.directory}/runtime-image/jre</argument>
                    <argument>--strip-debug</argument>
                    <argument>--no-header-files</argument>
                    <argument>--no-man-pages</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <executions>
              <execution>
                <id>runtime-image-run-instructions</id>
                <phase>package</phase>
                <goals>
                  <goal>run</goal>
                </goals>
                <configuration>
                  <target>
                    <echo file="${project.build.directory}/runtime-image/RUN.txt">Launch with:
  ${project.build.directory}/runtime-image/jre/bin/java -cp "${project.build.directory}/${project.build.finalName}.jar${path.separator}${project.build.directory}/runtime-image/lib/*" ${gimle.runtimeImage.launcherClass} [args...]
</echo>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
