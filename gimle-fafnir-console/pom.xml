<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.gimle</groupId>
    <artifactId>gimle</artifactId>
    <version>0.1.0-alpha.1</version>
  </parent>

  <artifactId>gimle-fafnir-console</artifactId>
  <packaging>jar</packaging>

  <name>Gimle Fafnir Console</name>
  <description>
    Fafnir's own web console SPA, built and tested by Bun but wrapped as a plain Maven module so
    `mvn verify` covers it too -- no Java sources here, just exec-maven-plugin executions that
    shell out to Bun and a resources-copy step that lands the built SPA at fafnir-console/**
    inside this module's own jar, for gimle-fafnir to depend on and serve at its own /console
    (see FafnirServer.serveConsole / FafnirMain). Mirrors gimle-console's exact pom.xml shape;
    the only difference is the bundled prefix (fafnir-console/** instead of console/**), so the
    two never collide on a classpath that somehow carried both.
  </description>

  <properties>
    <!-- Same reasoning as gimle-console's own maven.build.cache.enabled override: this module's
         real inputs (*.ts/*.tsx/package.json/bun.lock) are invisible to the root build-cache
         config's *.java/*.xml/*.yaml/*.properties glob. -->
    <maven.build.cache.enabled>false</maven.build.cache.enabled>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>bun-install</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>bun</executable>
              <workingDirectory>${project.basedir}</workingDirectory>
              <arguments>
                <argument>install</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>bun-build</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>bun</executable>
              <workingDirectory>${project.basedir}</workingDirectory>
              <arguments>
                <argument>run</argument>
                <argument>build</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>bun-test</id>
            <phase>test</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <!-- exec-maven-plugin has no built-in notion of "this is a test execution" the way
                   surefire does, so -DskipTests silently does nothing to it without this explicit
                   binding to the root pom's own skipTests property. -->
              <skip>${skipTests}</skip>
              <executable>bun</executable>
              <workingDirectory>${project.basedir}</workingDirectory>
              <arguments>
                <argument>run</argument>
                <argument>test</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <!-- Copies Vite's own conventional dist/ output (produced by the bun-build execution
               above) into this module's own jar under fafnir-console/**, for gimle-fafnir to read
               off its classpath at runtime (see FafnirMain's BundledSpa.resolve call). -->
          <execution>
            <id>copy-fafnir-console-dist</id>
            <phase>process-resources</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}/fafnir-console</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.basedir}/dist</directory>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
