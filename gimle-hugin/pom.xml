<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.gimle</groupId>
    <artifactId>gimle</artifactId>
    <version>0.1.0-alpha.2</version>
  </parent>

  <artifactId>gimle-hugin</artifactId>
  <packaging>jar</packaging>

  <name>Gimle Hugin</name>
  <description>
    The terminal cluster view: `gimle top`, a read-only live dashboard of nodes and instances
    with a per-instance drill-down. Contributed to the CLI as a CliExtension provider rather
    than built into it, so the whole feature is one directory and one reactor entry.
  </description>

  <dependencies>
    <dependency>
      <groupId>com.gimle</groupId>
      <artifactId>gimle-cli</artifactId>
    </dependency>
    <dependency>
      <groupId>com.gimle</groupId>
      <artifactId>gimle-core</artifactId>
    </dependency>
    <!--
      Java has no built-in raw terminal mode, so something must provide one. These two artifacts
      are that, and nothing else: jline-terminal for the Terminal abstraction, jline-terminal-ffm
      for the provider that reaches termios through the Foreign Function and Memory API.
      jline-native is excluded deliberately: it is the JNI provider, and it ships bundled native
      libraries, which this platform does not use anywhere. JLineTerminalSession selects the "ffm"
      provider by name, so the excluded one is never looked for.
    -->
    <dependency>
      <groupId>org.jline</groupId>
      <artifactId>jline-terminal</artifactId>
      <exclusions>
        <exclusion>
          <groupId>org.jline</groupId>
          <artifactId>jline-native</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.jline</groupId>
      <artifactId>jline-terminal-ffm</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        This module's own dependency graph (gimle-cli's whole closure plus jline-terminal and
        jline-terminal-ffm) is exactly what the standalone CLI archive ships (gimle-dist's own
        cli.xml assembly descriptor pulls those two jline artifacts in specifically because this
        module carries them as real dependencies; see gimle-dist/pom.xml's own comment on that
        include list). gimle-cli itself never depends on jline or on gimle-hugin: the dependency
        runs the other way, since gimle-hugin implements the CliExtension gimle-cli defines, and
        gimle-cli depending back on gimle-hugin would be circular, so gimle-cli's own dependency
        graph structurally cannot describe the CLI archive's real jar set. This module's graph is
        the closest one in the reactor that can, which is why gimle-dist copies this execution's
        target/bom.json (rewriting its root component from gimle-hugin to gimle-cli, the archive it
        actually describes) rather than gimle-cli's own bom.json into the standalone CLI archive's
        gimle-cli-*-cyclonedx.json. includeProvidedScope=false: a provided-scope dependency is never
        actually bundled.
      -->
      <plugin>
        <groupId>org.cyclonedx</groupId>
        <artifactId>cyclonedx-maven-plugin</artifactId>
        <configuration>
          <includeProvidedScope>false</includeProvidedScope>
        </configuration>
        <executions>
          <execution>
            <id>sbom</id>
            <phase>package</phase>
            <goals>
              <goal>makeBom</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
