<?xml version="1.0" encoding="UTF-8"?>
<!--
  Correctness property this file exists to guarantee: a module's cache key incorporates the
  cache keys of every module it depends on (reactor-aware hashing, built into the extension
  itself, not configured here), so editing gimle-core invalidates the cache entry for every
  downstream module transitively. What *is* configured here is making sure "changed" is detected
  completely for everything a hash can't see automatically: test resources, plugin-version-only
  changes (runAlways).

  Caching is enabled below, global default on. gimle-smoke-tests (never cache this slow suite:
  its cacheable behavior depends on whether -Psmoke is active, which the input hash can't see)
  and the four Bun/Vite modules, gimle-console, gimle-fafnir-console, gimle-andvari-console,
  gimle-docs (their real inputs are *.ts/*.tsx/package.json/bun.lock, invisible to the
  *.java/*.xml/*.yaml/*.properties glob below), opt back out individually via their own pom.xml's
  maven.build.cache.enabled=false property, which overrides this file's global default
  per-project (confirmed against the extension's own project-property override mechanism: a
  project-level property of the same name always wins over the global config here). That
  resolves the earlier blocker documented in this file's own history: the pinned extension
  version's XML schema has no projectsConfig/per-project-override element, without needing an
  extension version bump, since the override is a plain Maven property, not XML schema surface.

  Note for future editors of this comment block specifically: this is a real, parsed XML comment,
  not prose in a description tag, so two adjacent hyphen characters are illegal anywhere inside
  it per the XML spec, and break the extension's own config parser at Maven startup before the
  reactor even resolves, not just this file's own well-formedness. Avoid that pattern here even
  though the rest of this codebase's Javadoc/description prose uses a doubled hyphen as a dash
  freely.
-->
<cache xmlns="http://maven.apache.org/BUILD-CACHE-CONFIG/1.3.0"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://maven.apache.org/BUILD-CACHE-CONFIG/1.3.0 http://maven.apache.org/xsd/build-cache-config-1.3.0.xsd">
  <configuration>
    <enabled>true</enabled>
    <hashAlgorithm>SHA-256</hashAlgorithm>
    <local>
      <location>${user.home}/.m2/build-cache</location>
    </local>
  </configuration>

  <input>
    <global>
      <glob>{*.java,*.xml,*.yaml,*.yml,*.properties}</glob>
      <excludes>
        <!-- Deliberately "target", not "target/**": the extension rewrites this pattern's own
             "/" to the platform separator before handing it to java.nio.file's glob matcher, and
             on Windows that separator is "\", which is that same matcher's own escape character,
             so "target/**" becomes the literal glob text "target\**"; "\*" there is an illegal
             escape sequence, hard-failing every build ("Illegal char <*>") on Windows the moment
             the extension is actually active (it self-disables under Maven < 3.9, which is all
             that kept this latent before this project adopted a Maven 3.9+ wrapper). A bare
             directory-name exclude with no wildcard sidesteps the platform-specific rewrite
             entirely and still excludes the whole target/ subtree from the input hash, confirmed
             stable and reproducible across repeated builds, since this exclude is evaluated per
             path segment against every module in the reactor rather than the root project alone. -->
        <exclude>target</exclude>
      </excludes>
    </global>
  </input>

  <executionControl>
    <runAlways>
      <!-- fmt:check and checkstyle:check can change behavior on a plugin-version bump alone (a
           stricter Checkstyle rule release, an fmt-maven-plugin update) with zero source-file
           change, which the input-glob hash by design cannot see. Always running them is the
           safe default until/unless build time data shows they're the bottleneck. -->
      <goalsLists>
        <goalsList artifactId="fmt-maven-plugin">
          <goals>
            <goal>check</goal>
          </goals>
        </goalsList>
        <goalsList artifactId="maven-checkstyle-plugin">
          <goals>
            <goal>check</goal>
          </goals>
        </goalsList>
      </goalsLists>
    </runAlways>
    <!-- Another class of "changed" the input-glob hash by design cannot see: -DskipTests /
         -Dmaven.test.skip=true don't touch a single source file, so a project built once with
         either flag set gets the exact same checksum as the same source built without it. Without
         this block, a -DskipTests install populates a cache entry that a later plain test/verify
         of the same source then happily restores from, reporting BUILD SUCCESS with
         surefire:test's execution "skipped (cached)" and no surefire-reports directory ever
         written — the build looks green but nothing was actually tested. reconcile is the
         extension's own mechanism for exactly this shape of problem (its own schema
         documentation: "plugin properties which might be affected by command line flags, etc"):
         at restore time it reflectively reads the live surefire:test Mojo's skip/skipTests
         fields (propertyName here doubles as both the field name and, absent an expression, the
         parameter to read) and compares each against what was recorded when the cache entry was
         written. A mismatch forces the real goal to run instead of restoring it from cache, so a
         plain test/verify after a -DskipTests build always executes tests for real, while two
         plain runs of unchanged source still hit the cache exactly as before. -->
    <reconcile>
      <plugins>
        <plugin artifactId="maven-surefire-plugin" goal="test">
          <reconciles>
            <reconcile propertyName="skipTests" />
            <reconcile propertyName="skip" />
          </reconciles>
        </plugin>
      </plugins>
    </reconcile>
  </executionControl>
</cache>
