<?xml version="1.0" encoding="UTF-8"?>
<!--
  Correctness property this file exists to guarantee: a module's cache key incorporates the
  cache keys of every module it depends on (reactor-aware hashing, built into the extension
  itself, not configured here), so editing gimle-core invalidates the cache entry for every
  downstream module transitively. What *is* configured here is making sure "changed" is detected
  completely for everything a hash can't see automatically: test resources, plugin-version-only
  changes (runAlways).

  Caching is enabled below, global default on. gimle-smoke-tests (never cache this slow suite:
  its cacheable behavior depends on whether -Psmoke is active, which the input hash can't see)
  and the three Bun/Vite modules, gimle-console, gimle-fafnir-console, gimle-docs (their real
  inputs are *.ts/*.tsx/package.json/bun.lock, invisible to the *.java/*.xml/*.yaml/*.properties
  glob below), opt back out individually via their own pom.xml's
  maven.build.cache.enabled=false property, which overrides this file's global default
  per-project (confirmed against the extension's own project-property override mechanism: a
  project-level property of the same name always wins over the global config here). That
  resolves the earlier blocker documented in this file's own history: the pinned extension
  version's XML schema has no projectsConfig/per-project-override element, without needing an
  extension version bump, since the override is a plain Maven property, not XML schema surface.

  Note for future editors of this comment block specifically: this is a real, parsed XML comment,
  not prose in a description tag, so two adjacent hyphen characters are illegal anywhere inside
  it per the XML spec, and break the extension's own config parser at Maven startup before the
  reactor even resolves, not just this file's own well-formedness. Avoid that pattern here even
  though the rest of this codebase's Javadoc/description prose uses a doubled hyphen as a dash
  freely.
-->
<cache xmlns="http://maven.apache.org/BUILD-CACHE-CONFIG/1.3.0"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://maven.apache.org/BUILD-CACHE-CONFIG/1.3.0 http://maven.apache.org/xsd/build-cache-config-1.3.0.xsd">
  <configuration>
    <enabled>true</enabled>
    <hashAlgorithm>SHA-256</hashAlgorithm>
    <local>
      <location>${user.home}/.m2/build-cache</location>
    </local>
  </configuration>

  <input>
    <global>
      <glob>{*.java,*.xml,*.yaml,*.yml,*.properties}</glob>
      <excludes>
        <exclude>target/**</exclude>
      </excludes>
    </global>
  </input>

  <executionControl>
    <runAlways>
      <!-- fmt:check and checkstyle:check can change behavior on a plugin-version bump alone (a
           stricter Checkstyle rule release, an fmt-maven-plugin update) with zero source-file
           change, which the input-glob hash by design cannot see. Always running them is the
           safe default until/unless build time data shows they're the bottleneck. -->
      <goalsLists>
        <goalsList artifactId="fmt-maven-plugin">
          <goals>
            <goal>check</goal>
          </goals>
        </goalsList>
        <goalsList artifactId="maven-checkstyle-plugin">
          <goals>
            <goal>check</goal>
          </goals>
        </goalsList>
      </goalsLists>
    </runAlways>
  </executionControl>
</cache>
