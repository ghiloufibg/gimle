<?xml version="1.0" encoding="UTF-8"?>
<!--
  Correctness property this file exists to guarantee: a module's cache key incorporates the
  cache keys of every module it depends on (reactor-aware hashing, built into the extension
  itself, not configured here), so editing gimle-core invalidates the cache entry for every
  downstream module transitively. What *is* configured here is making sure "changed" is detected
  completely for everything a hash can't see automatically: test resources, plugin-version-only
  changes (runAlways), and the two modules whose real inputs the default glob doesn't cover
  (gimle-smoke-tests, gimle-console).
-->
<cache xmlns="http://maven.apache.org/BUILD-CACHE-CONFIG/1.1.0"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://maven.apache.org/BUILD-CACHE-CONFIG/1.1.0 http://maven.apache.org/xsd/build-cache-config-1.1.0.xsd">
  <configuration>
    <enabled>true</enabled>
    <hashAlgorithm>SHA-256</hashAlgorithm>
    <local>
      <location>${user.home}/.m2/build-cache</location>
    </local>
  </configuration>

  <input>
    <global>
      <glob>{*.java,*.xml,*.yaml,*.yml,*.properties}</glob>
      <excludes>
        <exclude>target/**</exclude>
      </excludes>
    </global>
  </input>

  <executionControl>
    <runAlways>
      <!-- fmt:check and checkstyle:check can change behavior on a plugin-version bump alone (a
           stricter Checkstyle rule release, an fmt-maven-plugin update) with zero source-file
           change, which the input-glob hash by design cannot see. Always running them is the
           safe default until/unless build time data shows they're the bottleneck. -->
      <goals>
        <goal artifactId="fmt-maven-plugin">check</goal>
        <goal artifactId="maven-checkstyle-plugin">check</goal>
      </goals>
    </runAlways>
  </executionControl>

  <projectsConfig>
    <!-- Subprocess-and-browser suite: spawns real ControlPlaneMain/AgentMain/WorkerMain
         processes and drives a real browser. Deliberately opt-in-only (-Psmoke) and slow by
         nature, exactly the kind of suite where a stale cached PASS would hide a real
         regression, so it's never cached, full stop. -->
    <project artifactId="gimle-smoke-tests">
      <cache enabled="false"/>
    </project>
    <!-- Bun/Vite build via exec-maven-plugin: no Java sources, and its real inputs
         (gimle-console/src/**, package.json, bun.lock) aren't covered by the *.java/*.xml/*.yaml
         glob above. Needs its own glob before it's safe to cache, so it's excluded here rather
         than silently under-hashed and risking a stale bundled console. -->
    <project artifactId="gimle-console">
      <cache enabled="false"/>
    </project>
  </projectsConfig>
</cache>
