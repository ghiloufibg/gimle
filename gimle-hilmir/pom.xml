<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.gimle</groupId>
    <artifactId>gimle</artifactId>
    <version>0.1.0-alpha.2</version>
  </parent>

  <artifactId>gimle-hilmir</artifactId>
  <packaging>jar</packaging>

  <name>Gimle Hilmir</name>
  <description>
    A deployment/bootstrap tool for multi-machine Gimle clusters: a declarative topology
    model, a semantic validator, and a pure launch planner that turns a topology into the
    exact per-machine process commands the platform's own process kinds expect.
  </description>

  <properties>
    <!-- Runtime-image profile (root pom): see gimle-agent/pom.xml for how this list was derived. -->
    <gimle.runtimeImage.launcherClass>com.gimle.hilmir.HilmirMain</gimle.runtimeImage.launcherClass>
    <gimle.runtimeImage.jdkModules>java.base,java.net.http</gimle.runtimeImage.jdkModules>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.gimle</groupId>
      <artifactId>gimle-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.gimle</groupId>
      <artifactId>gimle-core</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.gimle</groupId>
      <artifactId>gimle-mimir</artifactId>
    </dependency>
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        This module's own CycloneDX SBOM, reflecting exactly gimle-hilmir's own real dependency
        graph (the same graph `mvn -pl gimle-hilmir dependency:tree -Dscope=runtime` shows, which
        is how gimle-dist's own hilmir.xml assembly descriptor's <includes> list was derived):
        gimle-dist copies this module's target/bom.json into the standalone Hilmir archive's own
        gimle-hilmir-*-cyclonedx.json rather than generating a whole-reactor bom of its own and
        renaming it, since cyclonedx-maven-plugin's makeBom has no artifact-level filter and this
        module already carries the one dependency graph that archive actually ships.
        includeProvidedScope=false: a provided-scope dependency is never actually bundled.
      -->
      <plugin>
        <groupId>org.cyclonedx</groupId>
        <artifactId>cyclonedx-maven-plugin</artifactId>
        <configuration>
          <includeProvidedScope>false</includeProvidedScope>
        </configuration>
        <executions>
          <execution>
            <id>sbom</id>
            <phase>package</phase>
            <goals>
              <goal>makeBom</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
