<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.gimle</groupId>
    <artifactId>gimle</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>gimle-controlplane</artifactId>
  <packaging>jar</packaging>

  <name>Gimle Control Plane</name>
  <description>
    Manifest model, embedded state store, API server, scheduler, and level-triggered
    reconcilers for deployment, replica count, and health.
  </description>

  <properties>
    <!-- Runtime-image profile (root pom): see gimle-agent/pom.xml for how this list was derived. -->
    <gimle.runtimeImage.launcherClass>com.gimle.controlplane.ControlPlaneMain</gimle.runtimeImage.launcherClass>
    <gimle.runtimeImage.jdkModules>java.base,java.logging,java.xml,java.naming,jdk.httpserver,java.net.http</gimle.runtimeImage.jdkModules>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.gimle</groupId>
      <artifactId>gimle-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.gimle</groupId>
      <artifactId>gimle-core</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.gimle</groupId>
      <artifactId>gimle-module</artifactId>
    </dependency>
    <!-- Pure resources (console/**), no .class files: deliberately not `requires`d from
         module-info.java, so Maven's compiler plugin keeps it on the plain classpath instead of
         the module path (the same hybrid classpath/module-path behavior this project already
         relies on for OpenTelemetry, which ships no real module-info either). See
         ControlPlaneMain's console-resolution logic for how this gets read at runtime. -->
    <dependency>
      <groupId>com.gimle</groupId>
      <artifactId>gimle-console</artifactId>
    </dependency>
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
      <version>2.3</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.gimle</groupId>
      <artifactId>gimle-module</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <!-- Real, main-scope dependency: ApiServer signs incoming CSRs at /bootstrap/csr
         via CertificateAuthority.signCertificateRequest, and generates its own
         rotation CSRs via CertificateSigningRequests.generate. -->
    <dependency>
      <groupId>com.gimle</groupId>
      <artifactId>gimle-pki</artifactId>
    </dependency>
    <!-- The Raft-replicated store as its own process: manifest/deployment-spec types,
         StateMutation/MutationSink (the write vocabulary ApiServer and the reconcilers propose
         through), and StoreClient (the network client that replaced this module's own former
         in-process StateStore/RaftNode). StateStore itself also travels with this dependency,
         used only by test code as a fast, network-free reconciler-test fixture. -->
    <dependency>
      <groupId>com.gimle</groupId>
      <artifactId>gimle-mimir</artifactId>
    </dependency>
    <!-- Test-only: real gimle-fafnir crypto (SecretCipher/KeyFileManager/FafnirCrypto) plus its own
         HTTP surface (FafnirServer) back the InProcessFafnir test fixture: a real, in-process,
         same-JVM Fafnir replica for tests to exercise ApiServer's FafnirClient against, the same
         "real but embedded" posture InProcessStore already established for gimle-mimir. Never a
         main-scope dependency: production ApiServer only ever reaches Fafnir over the network,
         through FafnirClient, exactly like ControlPlaneMain's real fafnir-endpoint flag wiring. -->
    <dependency>
      <groupId>com.gimle</groupId>
      <artifactId>gimle-fafnir</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- ApiServerMetrics + MuninnShipper: ApiServer instruments its own endpoints and, when
         -Dgimle.controlplane.muninnEndpoint is configured, ships them to Muninn. -->
    <dependency>
      <groupId>com.gimle</groupId>
      <artifactId>gimle-observability</artifactId>
    </dependency>
  </dependencies>
</project>
