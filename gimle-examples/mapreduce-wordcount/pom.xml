<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Deliberately NOT parented on the real ../../pom.xml (com.gimle:gimle), the same posture
    gimle-examples/orders-platform already establishes for a tree that isn't platform code: this is
    a hand-built distributed-computing sample demonstrating genuine parallel data processing on a
    running Gimlé cluster, not something the platform's own reactor, formatting checks, or CI should
    build or touch. It is NOT listed in the root pom.xml's modules list, so a plain reactor build
    (mvn verify from the repo root) never discovers or touches anything under this directory. Build
    it explicitly instead:

      mvn -f gimle-examples/mapreduce-wordcount/pom.xml package

    Do NOT add a module entry for this directory to the root pom.xml: that would pull this tree's
    own build/test posture into the platform's own reactor and CI, defeating the entire point of
    keeping it separate. See README.md in this directory for what the app is and how to deploy it.
  -->
  <groupId>com.example.gimle-mapreduce-wordcount</groupId>
  <artifactId>mapreduce-wordcount</artifactId>
  <version>0.1.0</version>
  <packaging>pom</packaging>

  <name>Distributed Word Count (Gimlé manual-validation app)</name>
  <description>
    A real, deployable map-reduce style word-count application hosted as genuine Gimlé modules --
    not platform code, a hand-built sample for manually validating actual parallel distributed
    computation on a running Gimlé cluster: a map phase fanned out across multiple dedicated worker
    JVM replicas over the real fabric, reduced into one result by a batch coordinator.
  </description>

  <modules>
    <module>mapreduce-worker</module>
    <module>mapreduce-coordinator</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>25</maven.compiler.release>

    <!-- The platform version this app was last built against. gimle-module/gimle-core aren't
         published anywhere this standalone tree resolves from, so it depends on the exact jars a
         real Gimlé build already installed into the local repository (mvn install from the repo
         root). Bump this by hand if the platform's own version moves; there's no shared property
         to inherit it from since this pom deliberately has no parent. -->
    <gimle.platform.version>0.1.0-alpha.2</gimle.platform.version>
    <slf4j.version>2.0.17</slf4j.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.gimle</groupId>
        <artifactId>gimle-module</artifactId>
        <version>${gimle.platform.version}</version>
        <scope>provided</scope>
      </dependency>
      <!-- Not required by gimle-module transitively (its own module-info declares a plain, non-
           transitive "requires com.gimle.core"), so a module here that needs a gimle-core type
           (GimleClusterException) declares this dependency, and the matching "requires static
           com.gimle.core" in its own module-info, directly rather than relying on the classpath
           fallback + --add-reads workaround gimle-examples/orders-platform needs for Spring. -->
      <dependency>
        <groupId>com.gimle</groupId>
        <artifactId>gimle-core</artifactId>
        <version>${gimle.platform.version}</version>
        <scope>provided</scope>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>${slf4j.version}</version>
        <scope>provided</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
