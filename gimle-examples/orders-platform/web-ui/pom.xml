<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.example.gimle-orders-platform</groupId>
    <artifactId>orders-platform</artifactId>
    <version>0.1.0</version>
  </parent>

  <artifactId>web-ui</artifactId>
  <packaging>jar</packaging>

  <properties>
    <!-- Fills the add-reads compiler arg inherited from the parent's pluginManagement: see that
         pom's own comment for why the module needs it. -->
    <gimle.moduleName>com.example.webui</gimle.moduleName>
    <!-- The shaded jar's own filename: deployment.yaml's artifactPath points straight at this. -->
    <finalName>web-ui</finalName>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.gimle</groupId>
      <artifactId>gimle-module</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-context</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.11.4</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <version>1.11.4</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>${finalName}</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <executions>
          <!-- Test sources carry no module-info.java of their own, so this keeps the test
               compile on the plain classpath rather than patching them into com.example.webui's
               module descriptor; the module-path split above is a main-sources-only concern. -->
          <execution>
            <id>default-testCompile</id>
            <configuration>
              <useModulePath>false</useModulePath>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <!-- Same reasoning as the compiler plugin's testCompile override above: run the tests
               as a plain unnamed module, not patched into com.example.webui. -->
          <useModulePath>false</useModulePath>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
