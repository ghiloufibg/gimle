<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.example.gimle-orders-platform</groupId>
    <artifactId>orders-platform</artifactId>
    <version>0.1.0</version>
  </parent>

  <artifactId>orders-service</artifactId>
  <packaging>jar</packaging>

  <properties>
    <!-- Fills the add-reads compiler arg inherited from the parent's pluginManagement: see that
         pom's own comment for why the module needs it. -->
    <gimle.moduleName>com.example.orders</gimle.moduleName>
    <!-- The shaded jar's own filename: deployment.yaml's artifactPath points straight at this. -->
    <finalName>orders-service</finalName>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.gimle</groupId>
      <artifactId>gimle-module</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-context</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>com.zaxxer</groupId>
      <artifactId>HikariCP</artifactId>
    </dependency>
  </dependencies>

  <build>
    <finalName>${finalName}</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <!-- Appended to the parent's own module-info.class transformer (see that pom's
                   comment), not replacing it: the org.postgresql.Driver JDBC SPI registration
                   (META-INF/services/java.sql.Driver) has to survive the shade merge the same
                   way this module's own module-info.class does, or java.sql.DriverManager never
                   finds the driver once Spring/Postgres/HikariCP are all merged into one jar. -->
              <transformers combine.children="append">
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
