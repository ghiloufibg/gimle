<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
    "-//Checkstyle//DTD SuppressionXpathFilter Experimental Configuration 1.2//EN"
    "https://checkstyle.org/dtds/suppressions_xpath_1_2.xsd">
<suppressions>
  <!-- @Test methods are exempt from the camelCase check: they're the snake_case case instead.
       Note: the query targets METHOD_DEF/IDENT, not METHOD_DEF itself, since that's where
       MethodName actually reports the violation (matching requires an exact line/column hit). -->
  <suppress-xpath id="ProductionMethodName"
                   query="//METHOD_DEF[./MODIFIERS/ANNOTATION/IDENT[@text='Test']]/IDENT"/>
  <!-- Every method that is not @Test is exempt from the snake_case check. -->
  <suppress-xpath id="TestMethodName"
                   query="//METHOD_DEF[not(./MODIFIERS/ANNOTATION/IDENT[@text='Test'])]/IDENT"/>
</suppressions>
