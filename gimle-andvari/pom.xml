<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.gimle</groupId>
    <artifactId>gimle</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>gimle-andvari</artifactId>
  <packaging>jar</packaging>

  <name>Gimle Andvari</name>
  <description>
    The artifact registry: an immutable, content-addressed store for module jars, closing the gap
    where a deployment's artifactPath had to pre-exist on every node's own filesystem. Node agents
    pull from it on a cache miss the way a kubelet pulls a missing image; operators push through
    the control-plane proxy. Deliberately a dumb store of bytes plus a SHA-256 checksum -- module
    manifest validation stays where it already lives, in the worker's own ModuleArtifactReader.
  </description>

  <properties>
    <!-- Runtime-image profile (root pom): see gimle-agent/pom.xml for how this list was derived. -->
    <gimle.runtimeImage.launcherClass>com.gimle.andvari.AndvariMain</gimle.runtimeImage.launcherClass>
    <gimle.runtimeImage.jdkModules>java.base,java.logging,java.xml,java.naming</gimle.runtimeImage.jdkModules>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.gimle</groupId>
      <artifactId>gimle-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.gimle</groupId>
      <artifactId>gimle-mimir</artifactId>
    </dependency>
    <dependency>
      <groupId>com.gimle</groupId>
      <artifactId>gimle-pki</artifactId>
    </dependency>
    <!-- No Java sources of its own: just the built web console SPA bundled at
         andvari-console/** inside its own jar (see that module's pom.xml). AndvariMain resolves
         it off the classpath at startup via BundledSpa, the same pattern gimle-fafnir already
         uses for gimle-fafnir-console. -->
    <dependency>
      <groupId>com.gimle</groupId>
      <artifactId>gimle-andvari-console</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
  </dependencies>
</project>
