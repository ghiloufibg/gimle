#!/usr/bin/env bash
# Rejects any commit message mentioning an AI assistant (CLAUDE.md's own convention, previously
# documented but never actually enforceable -- nothing installed this hook anywhere). Install with
# scripts/install-hooks.sh.
set -euo pipefail

commit_msg_file="$1"

pattern='claude|copilot|chatgpt|gpt-4|gpt-5|openai|anthropic|gemini|codex|cursor ai|ai assistant|ai-generated|generated by ai|generated with ai'

if grep -Eiq "$pattern" "$commit_msg_file"; then
  echo "commit-msg: commit message must not mention an AI assistant (CLAUDE.md convention)." >&2
  exit 1
fi
