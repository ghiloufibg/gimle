<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.gimle</groupId>
    <artifactId>gimle</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>gimle-maven-plugin</artifactId>
  <packaging>maven-plugin</packaging>

  <name>Gimle Maven Plugin</name>
  <description>
    spring-boot:run-style developer-experience goals for this repo, invoked straight from the
    reactor root with no -pl needed: `mvn gimle:controlplane`, `mvn gimle:agent`, `mvn gimle:deploy
    -Dgimle.deploy.file=...`. Each goal self-filters to its one target module (checking
    project.getArtifactId()) and no-ops for every other reactor project -- a direct goal invocation
    with no bound lifecycle phase iterates the whole reactor by default, and this is the standard, only
    idiom for "this goal only makes sense for one specific module." Deliberately not bound to any
    lifecycle phase, so none of this ever runs as a side effect of `mvn verify`/`mvn install`.
  </description>

  <properties>
    <!-- Overrides the root pom's release=25: maven-plugin-plugin's descriptor goal reads compiled
         Mojo class files with a bundled ASM version that doesn't yet recognize Java 25 class files
         (major version 69): "Unsupported class file major version 69", confirmed by hitting it
         directly. Mojo classes also run IN-PROCESS inside the invoking `mvn` launcher's own JVM
         (whichever JDK the developer has active, not necessarily this repo's JDK 25 requirement for
         the application modules), so a broadly-compatible LTS target is correct here regardless. -->
    <maven.compiler.release>21</maven.compiler.release>
    <maven.version>3.8.9</maven.version>
    <maven-plugin-annotations.version>3.13.1</maven-plugin-annotations.version>
    <!-- Must match the maven-resolver-api jar Maven 3.8.9 itself ships in its own lib/ directory
         exactly (verified against this environment's actual install): Mojo code sharing
         RepositorySystem/RepositorySystemSession instances with the live Maven process needs
         binary-compatible resolver classes, not merely the newest release. -->
    <maven-resolver.version>1.6.3</maven-resolver.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-plugin-api</artifactId>
      <version>${maven.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-core</artifactId>
      <version>${maven.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.maven.plugin-tools</groupId>
      <artifactId>maven-plugin-annotations</artifactId>
      <version>${maven-plugin-annotations.version}</version>
      <scope>provided</scope>
    </dependency>
    <!-- AgentMojo's cross-module worker-classpath resolution only. maven-resolver-impl/
         connector-basic/transport-* are deliberately NOT declared here: Maven's own runtime
         already provides live instances of those (RepositorySystem itself is @Component-injected
         from the running Maven process), only the API surface is needed at compile time. -->
    <dependency>
      <groupId>org.apache.maven.resolver</groupId>
      <artifactId>maven-resolver-api</artifactId>
      <version>${maven-resolver.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.maven.resolver</groupId>
      <artifactId>maven-resolver-util</artifactId>
      <version>${maven-resolver.version}</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-plugin-plugin</artifactId>
        <version>3.13.1</version>
      </plugin>
    </plugins>
  </build>
</project>
